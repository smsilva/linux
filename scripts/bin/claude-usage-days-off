#!/bin/bash
this_script_path="$(realpath "${0}")"
this_script_name="${this_script_path##*/}"

window_seconds=$(( 7 * 24 * 60 * 60 ))
last_day_seconds=$(( 6 * 60 * 60 ))
weekdays=(mon tue wed thu fri sat sun)
file_format="'<YYYY-MM-DD> [reason]', '<mon|tue|wed|thu|fri|sat|sun> [reason]' or 'worked <YYYY-MM-DD>'"

show_usage() {
  cat <<EOF

  Prints the days off of the weekly Claude quota window that resets at
  --resets-at, with the same rules as Nereus (#2110): a dated day off wins
  over a date worked, which wins over a weekday off (the work week). Days are
  cut at midnight in the time zone (TZ).

  One line per day off: "<start epoch> <end epoch> <date> <kind> <reason>",
  where kind is "day" for a day off, or "last" for the hours after the reset's
  midnight that belong to the plan's last day when that day is off. Prints
  nothing when there is no day off in the window.

  The days off come from the flags and from a file, combined. The file is
  --days-off-file, else \$CLAUDE_USAGE_DAYS_OFF_FILE, else
  ${XDG_CONFIG_HOME:-${HOME}/.config}/nereus/usage/days-off
  when it exists. One entry per line, # comments and blank lines ignored:

    2026-12-25 Christmas    a dated day off
    sat Weekend             a weekday not worked
    worked 2026-11-14       a date worked anyway

  A reason has 1 to 40 characters (default: off).

    Options:

      -h,  --help           Show this help
      -r,  --resets-at      Epoch seconds of the window's reset
           --day-off        <YYYY-MM-DD>[=<reason>], a dated day off (repeatable)
           --weekday-off    <mon..sun>[=<reason>], a weekday not worked (repeatable)
           --worked         <YYYY-MM-DD>, a date worked anyway (repeatable)
           --days-off-file  File with the days off (default: see above)

    Examples:

      ${this_script_name} --resets-at 1794186000

      ${this_script_name} --resets-at 1794186000 --weekday-off sat=Weekend --weekday-off sun=Weekend

      ${this_script_name} --resets-at 1794186000 --day-off 2026-11-13=Holiday --worked 2026-11-14

      ${this_script_name} --resets-at 1794186000 --days-off-file ~/days-off

EOF
}

declare -A dated_off weekday_off worked_dates

# Fails unless a value is a real date in YYYY-MM-DD
valid_date() {
  [[ "${1}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && [[ "$(date --date "${1}" '+%F' 2>/dev/null)" == "${1}" ]]
}

# Fails unless a value is a reason of 1 to 40 characters
valid_reason() {
  [[ "${#1}" -ge 1 && "${#1}" -le 40 ]]
}

# Fails unless a value is a weekday, mon to sun
valid_weekday() {
  [[ " ${weekdays[*]} " == *" ${1} "* ]]
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case "${1}" in
    -h | --help )
      show_usage
      exit 1
      ;;

    -r | --resets-at )
      shift
      resets_at="${1}"
      ;;

    --day-off )
      shift
      day="${1%%=*}"
      reason="off"
      [[ "${1}" == *=* ]] && reason="${1#*=}"
      if ! valid_date "${day}" || ! valid_reason "${reason}"; then
        echo "--day-off must be <YYYY-MM-DD>[=<reason of 1 to 40 characters>]: '${1}'" >&2
        exit 1
      fi
      dated_off["${day}"]="${reason}"
      ;;

    --weekday-off )
      shift
      weekday="${1%%=*}"
      weekday="${weekday,,}"
      reason="off"
      [[ "${1}" == *=* ]] && reason="${1#*=}"
      if ! valid_weekday "${weekday}" || ! valid_reason "${reason}"; then
        echo "--weekday-off must be <mon|tue|wed|thu|fri|sat|sun>[=<reason of 1 to 40 characters>]: '${1}'" >&2
        exit 1
      fi
      weekday_off["${weekday}"]="${reason}"
      ;;

    --worked )
      shift
      if ! valid_date "${1}"; then
        echo "--worked must be <YYYY-MM-DD>: '${1}'" >&2
        exit 1
      fi
      worked_dates["${1}"]=1
      ;;

    --days-off-file )
      shift
      days_off_file="${1}"
      if [[ ! -f "${days_off_file}" ]]; then
        echo "No days-off file: '${days_off_file}'" >&2
        exit 1
      fi
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage >&2
      exit 1
      ;;

  esac
  shift
done

if ! [[ "${resets_at}" =~ ^[0-9]+$ ]]; then
  echo "--resets-at must be epoch seconds: '${resets_at}'" >&2
  exit 1
fi

if [[ -z "${days_off_file}" ]]; then
  days_off_file="${CLAUDE_USAGE_DAYS_OFF_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/nereus/usage/days-off}"
  [[ -f "${days_off_file}" ]] || days_off_file=""
fi

# The file comes first, so a flag given for the same date or weekday wins
declare -A file_dated_off file_weekday_off file_worked_dates

if [[ -n "${days_off_file}" ]]; then
  line_number=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_number=$(( line_number + 1 ))
    read -r key reason <<< "${line}"
    [[ -z "${key}" || "${key}" == \#* ]] && continue
    key="${key,,}"
    if [[ "${key}" == worked ]]; then
      if valid_date "${reason}"; then
        file_worked_dates["${reason}"]=1
        continue
      fi
    else
      reason="${reason:-off}"
      if valid_reason "${reason}" && valid_date "${key}"; then
        file_dated_off["${key}"]="${reason}"
        continue
      fi
      if valid_reason "${reason}" && valid_weekday "${key}"; then
        file_weekday_off["${key}"]="${reason}"
        continue
      fi
    fi
    echo "${days_off_file}:${line_number}: expected ${file_format}, a reason of 1 to 40 characters: '${line}'" >&2
    exit 1
  done < "${days_off_file}"

  for day in "${!file_dated_off[@]}"; do
    [[ -n "${dated_off[${day}]}" ]] || dated_off["${day}"]="${file_dated_off[${day}]}"
  done
  for weekday in "${!file_weekday_off[@]}"; do
    [[ -n "${weekday_off[${weekday}]}" ]] || weekday_off["${weekday}"]="${file_weekday_off[${weekday}]}"
  done
  for day in "${!file_worked_dates[@]}"; do
    worked_dates["${day}"]=1
  done
fi

[[ "${#dated_off[@]}" -eq 0 && "${#weekday_off[@]}" -eq 0 ]] && exit 0

# Every day that holds part of the window, from the midnight before its start
window_start=$(( resets_at - window_seconds ))
day_start=$(date --date "$(date --date "@${window_start}" '+%F')" '+%s')
declare -A off_reason
reset_date=$(date --date "@${resets_at}" '+%F')

while [[ "${day_start}" -lt "${resets_at}" ]]; do
  read -r day weekday_number < <(date --date "@${day_start}" '+%F %u')
  day_end=$(date --date "${day} +1 day" '+%s')
  weekday="${weekdays[weekday_number - 1]}"
  reason=""
  if [[ -n "${dated_off[${day}]}" ]]; then
    reason="${dated_off[${day}]}"
  elif [[ -z "${worked_dates[${day}]}" && -n "${weekday_off[${weekday}]}" ]]; then
    reason="${weekday_off[${weekday}]}"
  fi
  if [[ -n "${reason}" ]]; then
    off_reason["${day}"]="${reason}"
    echo "${day_start} ${day_end} ${day} day ${reason}"
  fi
  last_date="${day}"
  last_start="${day_start}"
  day_start="${day_end}"
done

# The hours after the reset's midnight belong to the plan's last day when the reset is within 6 hours of it: off when that day is off
if [[ "${last_date}" == "${reset_date}" && "${last_start}" -lt "${resets_at}" && $(( resets_at - last_start )) -lt "${last_day_seconds}" ]]; then
  previous_date=$(date --date "${reset_date} -1 day" '+%F')
  if [[ -n "${off_reason[${previous_date}]}" && -z "${off_reason[${reset_date}]}" ]]; then
    echo "${last_start} $(date --date "${reset_date} +1 day" '+%s') ${reset_date} last ${off_reason[${previous_date}]}"
  fi
fi
