#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Rebase the current branch against a target branch.

    ${this_script_name} to <branch>    Pull <branch> with --rebase --prune, then rebase current branch onto it
    ${this_script_name} from <branch>  Pull <branch> with --rebase --prune, then rebase current branch onto it

    Options:

      -h, --help  Show this help

    Examples:

      ${this_script_name} to main

      ${this_script_name} from dev

EOF
}

checkout_branch() {
  local branch="${1}"

  git checkout "${branch}" 2> /dev/null
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "  ERROR: Failed to switch to ${branch}"
    exit 1
  fi

  git pull --rebase --prune 2> /dev/null
}

rebase_from_source_to_target() {
  local source_branch="${1}"
  local target_branch="${2}"

  echo "1. Update SOURCE: ${source_branch}"
  checkout_branch "${source_branch}" 2> /dev/null

  echo ""
  echo "2. Update TARGET: ${target_branch}"
  checkout_branch "${target_branch}" 2> /dev/null

  echo ""
  echo "3. Rebase from SOURCE ${source_branch} to TARGET ${target_branch}"
  echo ""

  git rebase "${source_branch}"

  if [ $? -ne 0 ]; then
    echo ""
    echo "  ERROR: Failed to rebase ${source_branch} onto ${target_branch}"
    exit 1
  fi
}

subcommand="${1}"
input_branch="${2}"
current_branch="$(git rev-parse --abbrev-ref HEAD)"

case "${subcommand}" in
  -h | --help )
    show_usage
    exit 0
    ;;

  to )
    source_branch="${current_branch}"
    target_branch="${input_branch}"
    rebase_from_source_to_target "${source_branch}" "${target_branch}"
    ;;

  from )
    source_branch="${input_branch}"
    target_branch="${current_branch}"
    rebase_from_source_to_target "${source_branch}" "${target_branch}"
    ;;

  * )
    echo "Unknown subcommand: ${subcommand}"
    show_usage
    exit 1
    ;;
esac
