{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "play service-logout",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "play service-login",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "claude-yaml-validator",
            "statusMessage": "Validating YAML..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/silvios/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "smsilva-linux": {
      "source": {
        "source": "github",
        "repo": "smsilva/linux",
        "ref": "dev"
      }
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "effortLevel": "high",
  "fileCheckpointingEnabled": false,
  "language": "pt-BR",
  "skillListingBudgetFraction": 0.04,
  "theme": "dark",
  "voiceEnabled": true
}
