{
  "skillListingBudgetFraction": 0.04,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "about-me": "off",
    "presentation-prep": "off",
    "skill-usage-review": "off",
    "use-browser": "off",
    "daily": "off",
    "all-skills-review": "off",
    "video-captions": "off",
    "pptx": "off",
    "anthropic-skills:pptx": "on",
    "diagnosing-bugs": "off",
    "k9s-tutor": "off",
    "speak-words": "user-invocable-only",
    "panel": "user-invocable-only",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:skill-creator": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "play service-logout",
            "async": true
          },
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/pontos-save\" hook",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "play service-login",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/agent-name\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/pontos-save\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/pontos-save\" hook",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/agent-name\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/pontos-save\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/claude-guard-main-clone\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.scripts/claude-usage-plan-hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/silvios/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "docs@flow-cloud-hub": false,
    "nats-channel@synadia-plugins": false,
    "planning@flow-cloud-hub": false,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "github@synced": false
  },
  "extraKnownMarketplaces": {
    "synadia-plugins": {
      "source": {
        "source": "github",
        "repo": "synadia-ai/synadia-agents"
      },
      "autoUpdate": true
    }
  },
  "language": "pt-BR",
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "remote": {
    "defaultEnvironmentId": "env_01CotcYiVnddBdypZaRN2J6p"
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
