#!/bin/bash
cluster_name="${1}"

list_k3d_clusters() {
  k3d cluster list
}

if [[ -z "${cluster_name}" ]]; then
  cluster_name=$(list_k3d_clusters | sed 1d | sort | fzf | awk '{ print $1 }')
fi

if [[ -z "${cluster_name}" ]]; then
  k3d cluster list
else
  k3d cluster delete "${cluster_name}"
  echo ""
  k3d cluster list
fi
