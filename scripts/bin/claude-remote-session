#!/bin/bash
this_script_path="$(realpath "${0}")"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Opens a new tmux window and starts a Claude Code session in it (agent, which
  turns on Remote Control), so the session can be driven from the phone or
  claude.ai/code. Prints the window, the pane and the session's URL.

    Options:

      -h,  --help       Show this help
      -d,  --directory  Folder the session starts in (default: current folder)
      -n,  --name       Name of the new tmux window (default: the session's NATO name, set by agent)
      -p,  --prompt     First prompt of the session (default: none)
      -t,  --timeout    Seconds to wait for each step (default: 30)

    Examples:

      ${this_script_name}

      ${this_script_name} --directory ~/git/getnereus/nereus --name nereus-rc

      ${this_script_name} --prompt "Continue issue #123 from its last comment"

EOF
}

directory="${PWD}"
window_name=""
first_prompt=""
timeout_seconds="30"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case "${1}" in
    -h | --help )
      show_usage
      exit 1
      ;;

    -d | --directory )
      shift
      directory="${1?}"
      ;;

    -n | --name )
      shift
      window_name="${1?}"
      ;;

    -p | --prompt )
      shift
      first_prompt="${1?}"
      ;;

    -t | --timeout )
      shift
      timeout_seconds="${1?}"
      ;;

    * )
      echo "Unknown option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

if [ -z "${TMUX}" ] && ! tmux list-sessions > /dev/null 2>&1; then
  echo "No tmux server is running." >&2
  exit 1
fi

if [ ! -d "${directory}" ]; then
  echo "No such folder: ${directory}" >&2
  exit 1
fi

# Wait until the pane shows a line matching the pattern, up to the timeout
wait_for() {
  local pattern="${1?}"
  local deadline=$(( SECONDS + timeout_seconds ))

  while (( SECONDS < deadline )); do
    if tmux capture-pane -p -J -t "${pane_id}" | grep --quiet --extended-regexp "${pattern}"; then
      return 0
    fi
    sleep 0.5
  done

  return 1
}

name_option=()
if [ -n "${window_name}" ]; then
  name_option=(-n "${window_name}")
fi

# The prompt travels in the window's environment, so no quoting of it can break the command
environment_option=()
window_command='bash -lc "agent; exec bash"'
if [ -n "${first_prompt}" ]; then
  environment_option=(-e "AGENT_FIRST_PROMPT=${first_prompt}")
  window_command='bash -lc "agent \"\${AGENT_FIRST_PROMPT}\"; exec bash"'
fi

read -r window pane_id < <(
  tmux new-window \
    "${name_option[@]}" \
    "${environment_option[@]}" \
    -c "${directory}" \
    -P \
    -F '#{session_name}:#{window_index} #{pane_id}' \
    "${window_command}"
)

echo "window: ${window} pane: ${pane_id}"

if ! wait_for 'remote-control is active'; then
  echo "Remote Control did not turn on in ${pane_id} within ${timeout_seconds}s; look at the window." >&2
  exit 1
fi

url="$(tmux capture-pane -p -J -t "${pane_id}" | grep --only-matching --extended-regexp 'https://claude\.ai/code/session_[A-Za-z0-9]+' | tail -1)"

echo "url: ${url}"
