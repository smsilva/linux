{
  "skillListingBudgetFraction": 0.04,
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "play service-logout",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "play service-login",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/silvios/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "azure@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true
  },
  "language": "pt-BR",
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(terraform fmt:*) in azure-kubernetes",
      "Bash(terraform validate:*) in azure-kubernetes",
      "Bash(terraform init -backend=false:*) in azure-kubernetes"
    ],
    "soft_deny": [
      "$defaults",
      "terraform apply -replace on module.ingress_istio[0].helm_release.istio_gateway (documented footgun: destroys/recreates LoadBalancer, changes public IP, breaks DNS for all three hosts)",
      "az aks get-credentials --admin (bypasses Azure RBAC, writes kube_admin_config credentials in cleartext)"
    ]
  },
  "voiceEnabled": false
}
