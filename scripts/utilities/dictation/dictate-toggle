#!/bin/bash
# Toggle voice dictation: first run starts recording, second run stops,
# transcribes with whisper.cpp (pt) and copies the text to the clipboard.
# Presses while a transcription is running are ignored.
state_directory="${XDG_RUNTIME_DIR:-/tmp}/dictate"
pid_file="${state_directory}/record.pid"
lock_file="${state_directory}/transcribe.lock"
wav_file="${state_directory}/record.wav"
max_seconds="${DICTATE_MAX_SECONDS:-120}"
whisper_directory="${WHISPER_DIRECTORY:-${HOME}/whisper.cpp}"

mkdir -p "${state_directory}"

# Small is the fastest acceptable model on CPU; set DICTATE_MODEL to override.
if [[ -z "${DICTATE_MODEL}" ]]; then
  for candidate in large-v3-turbo small medium; do
    if [[ -f "${whisper_directory}/models/ggml-${candidate}.bin" ]]; then
      DICTATE_MODEL="${whisper_directory}/models/ggml-${candidate}.bin"
      break
    fi
  done
fi

# whisper.cpp runs slower with hyperthreads; use physical cores only.
physical_cores="$(lscpu --parse=core | grep --invert-match '^#' | sort --unique | wc --lines)"

# xclip and wl-copy stay in the background serving the selection; they must
# not inherit the lock, or every later press would see "still transcribing".
copy_to_clipboard() {
  if [[ "${XDG_SESSION_TYPE}" == "wayland" ]]; then
    wl-copy 9>&-
  else
    xclip -selection clipboard 9>&-
  fi
}

# Holds the lock for the whole transcription; a second instance exits at once.
exec 9> "${lock_file}"
if ! flock --nonblock 9; then
  notify-send "Ditado" "Ainda transcrevendo, aguarde…"
  exit 0
fi

if [[ -f "${pid_file}" ]]; then
  kill "$(cat "${pid_file}")" 2> /dev/null
  rm -f "${pid_file}"
  sleep 0.3

  notify-send "Ditado" "Transcrevendo…"

  start_time="${SECONDS}"

  text=$("${whisper_directory}/build/bin/whisper-cli" \
    --model "${DICTATE_MODEL?}" \
    --language pt \
    --no-timestamps \
    --no-prints \
    --threads "${physical_cores}" \
    --file "${wav_file}" \
  | tr '\n' ' ' \
  | sed 's/^ *//; s/ *$//')

  printf '%s' "${text}" | copy_to_clipboard

  notify-send "Ditado" "Copiado ($(( SECONDS - start_time ))s): ${text:0:60}…"

  # Auto-paste (optional; needs ydotoold running and /dev/uinput access).
  # ydotool 0.1.x syntax (Ubuntu 24.04 ships 0.1.8):
  # ydotool key ctrl+shift+v
  # ydotool 1.x syntax:
  # ydotool key 29:1 42:1 47:1 47:0 42:0 29:0
else
  # The recorder must not inherit the lock, or it would block the stop press.
  arecord -q -f S16_LE -r 16000 -c 1 --duration "${max_seconds}" "${wav_file}" 9>&- &
  echo $! > "${pid_file}"
  notify-send "Ditado" "Gravando… (máx. ${max_seconds}s)"
fi
