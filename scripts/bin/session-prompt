#!/usr/bin/env bash
# The session prompt of one agent (smsilva/linux#203, from getnereus/nereus#1239): the instructions a session leaves
# so the next one, after /clear, resumes the same way of working. One file per agent name (agent-name), inside the
# main clone's git folder, so every worktree of that agent finds the same one, parallel agents never overwrite each
# other, and no clone can bring a prompt with it: a file in the working tree could come from the repository's authors,
# and the hook tells the session to follow it.

this_script_path="$(realpath "${0}")"
this_script_name="${this_script_path##*/}"
PATH="${this_script_path%/*}:${PATH}"

show_usage() {
  cat <<EOF

  Keep the session prompt of one agent: <git common dir>/session-prompts/<agent>.md

    Commands:

      path                   Print the agent's prompt file
      show                   Print the agent's prompt
      save --file <draft>    Write the draft as the agent's prompt (with the board's team panel, when PROMPT_TEAM is set)
      clear --topic <name>   Archive the prompt to ~/.claude/prompts/<repository>/<name>.md, then remove it
      hook                   Claude Code hook (SessionStart, SessionEnd), JSON on stdin: after /clear prints the
                             agent's prompt, marked STALE when the session that ended did not rewrite it; a session
                             ending for good archives the prompt

    Options:

      --agent <name>   The agent (default: AGENT_NAME, else the name agent-name holds for the session)
      --file <draft>   The draft to save
      --topic <name>   The archive name for clear
      --help           Show this help

    Environment:

      PROMPT_ARCHIVE   Archive folder (default: ~/.claude/prompts/<repository>)
      PROMPT_TEAM      Command whose output save appends as the board's team panel (default: none)

    Examples:

      ${this_script_name} show

      ${this_script_name} save --file /tmp/draft.md

      ${this_script_name} clear --topic status-line
EOF
}

fail() {
  echo "${this_script_name}: ${*}" >&2
  exit 1
}

# The name agent-name holds for a session id, empty when it holds none
held_name() {
  local session_id="${1}"

  [[ -n "${session_id}" ]] || return 0
  command -v agent-name > /dev/null || return 0
  agent-name whoami --session-id "${session_id}" 2> /dev/null || true
}

# The name Claude Code recorded in the session's transcript (--name), the last one when renamed; empty when none
transcript_name() {
  local transcript="${1}"

  [[ -n "${transcript}" && -r "${transcript}" ]] || return 0
  jq --raw-output 'select(.type == "agent-name") | .agentName // empty' "${transcript}" 2> /dev/null | tail --lines 1
}

# Sets agent, main_clone, folder, file and started in this shell, so a failure stops the script, not a subshell
resolve() {
  local session_id="${1:-${CLAUDE_CODE_SESSION_ID:-}}"
  local common_dir

  # AGENT_NAME first: the launcher (agent) took it before Claude Code started, so a hook never races agent-name's own
  # SessionStart hook for it
  [[ -z "${agent}" ]] && agent="${AGENT_NAME:-}"
  [[ -z "${agent}" ]] && agent="$(held_name "${session_id}")"
  [[ -n "${agent}" ]] || fail "no agent name: run inside a named session or pass --agent <name>"
  [[ "${agent}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "not an agent name: ${agent}"

  common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" || fail "not inside a git repository"
  main_clone="$(dirname "${common_dir}")"
  folder="${common_dir}/session-prompts"
  file="${folder}/${agent}.md"
  started="${folder}/${agent}.session"

  # Nothing under the git folder comes with a clone, but never follow a link there either
  local path
  for path in "${folder}" "${file}" "${started}"; do
    [[ -L "${path}" ]] && fail "refusing a symbolic link: ${path}"
  done
  return 0
}

# Writes stdin to a file through a temporary file in the same folder, so a link planted at the name is replaced, not followed
write_file() {
  local target="${1}"
  local temporary

  temporary="$(mktemp "${target}.XXXXXX")" || fail "cannot write ${target}"
  cat > "${temporary}"
  mv --force "${temporary}" "${target}"
}

# The epoch the session started, empty unless the file holds only digits (it is read inside an arithmetic test)
started_at() {
  local value

  [[ -s "${started}" ]] || return 0
  value="$(head --bytes 20 "${started}")"
  [[ "${value}" =~ ^[0-9]+$ ]] && echo "${value}"
}

# Moves the prompt to the archive under <name>.md, with the date (then the time) when taken
archive_prompt() {
  local name="${1}"
  local archive_directory="${PROMPT_ARCHIVE:-${HOME}/.claude/prompts/${main_clone##*/}}"
  local archive

  mkdir --parents "${archive_directory}"
  archive="${archive_directory}/${name}.md"
  [[ -e "${archive}" ]] && archive="${archive_directory}/${name}-$(date +%F).md"
  [[ -e "${archive}" ]] && archive="${archive_directory}/${name}-$(date +%F-%H%M%S).md"
  [[ -e "${archive}" ]] && fail "${archive} already exists: pick another topic"
  cp "${file}" "${archive}"
  cmp --quiet "${file}" "${archive}" || fail "the copy ${archive} differs from ${file}: kept both"
  rm "${file}"
  echo "archived to ${archive}, removed ${file}"
}

hook() {
  local input event session_id source_or_reason saved state started_epoch

  input="$(cat)"
  command -v jq > /dev/null || exit 0
  event="$(jq --raw-output '.hook_event_name // empty' <<< "${input}" 2> /dev/null)"
  session_id="$(jq --raw-output '.session_id // empty' <<< "${input}" 2> /dev/null)"
  # agent-name's SessionEnd hook runs in parallel and may free the name first: resolve it once, then fall back to
  # the name the transcript records
  [[ -z "${agent}" ]] && agent="${AGENT_NAME:-}"
  [[ -z "${agent}" ]] && agent="$(held_name "${session_id}")"
  [[ -z "${agent}" ]] && agent="$(transcript_name "$(jq --raw-output '.transcript_path // empty' <<< "${input}" 2> /dev/null)")"
  (resolve "${session_id}" 2> /dev/null) || exit 0
  resolve "${session_id}"

  # Nereus keeps its own copy until getnereus/nereus#1953; two hooks would print the prompt twice
  [[ -x "${main_clone}/scripts/session/prompt" ]] && exit 0

  case "${event}" in
    SessionStart )
      source_or_reason="$(jq --raw-output '.source // empty' <<< "${input}")"
      if [[ "${source_or_reason}" == "clear" && -s "${file}" ]]; then
        saved="$(date --reference "${file}" +%s)"
        state=""
        started_epoch="$(started_at)"
        if [[ -n "${started_epoch}" ]] && (( saved < started_epoch )); then
          state=" STALE: not rewritten by the session that started at $(date --date "@${started_epoch}" '+%F %H:%M'). Say so to the owner before following it, and rewrite it (session-prompt save) once the state is checked."
        fi
        echo "Session prompt of ${agent} (session-prompt show, saved $(date --date "@${saved}" '+%F %H:%M')):${state:- follow it.}"
        echo
        cat "${file}"
      fi
      mkdir --parents "${folder}"
      date +%s | write_file "${started}"
      ;;

    SessionEnd )
      source_or_reason="$(jq --raw-output '.reason // empty' <<< "${input}")"
      # /clear keeps the agent and its name: the prompt stays for the next session
      [[ "${source_or_reason}" == "clear" ]] && exit 0
      rm --force "${started}"
      [[ -s "${file}" ]] || exit 0
      archive_prompt "${agent}-$(date +%F)" > /dev/null
      ;;

  esac
}

command="${1:-}"
shift

agent=""
draft=""
topic=""

while [[ $# -gt 0 ]]; do
  case "${1}" in
    --agent )
      agent="${2?--agent needs a name}"
      shift 2
      ;;

    --file )
      draft="${2?--file needs a path}"
      shift 2
      ;;

    --topic )
      topic="${2?--topic needs a name}"
      shift 2
      ;;

    --help )
      show_usage
      exit 0
      ;;

    * )
      show_usage >&2
      exit 2
      ;;

  esac
done

case "${command}" in
  path )
    resolve
    echo "${file}"
    ;;

  show )
    resolve
    [[ -s "${file}" ]] || fail "no session prompt for ${agent} (${file})"
    cat "${file}"
    ;;

  save )
    [[ -n "${draft}" ]] || fail "save needs --file <draft>"
    [[ -s "${draft}" ]] || fail "the draft ${draft} is missing or empty"
    resolve
    mkdir --parents "${folder}"
    # Only a command the owner set: a repository's own scripts never run from here
    team="${PROMPT_TEAM:-}"
    {
      cat "${draft}"
      if [[ -n "${team}" ]]; then
        echo
        echo "## Board at save ($(date '+%F %H:%M'))"
        echo
        echo "Who holds what, from the board, not from memory: check it again before acting on a peer's item."
        echo
        echo '```text'
        bash -c "${team}" 2>&1 || echo "(the board could not be read)"
        echo '```'
      fi
    } | write_file "${file}"
    echo "saved ${file} (agent ${agent})"
    ;;

  clear )
    [[ -n "${topic}" ]] || fail "clear needs --topic <name>"
    resolve
    [[ -s "${file}" ]] || fail "no session prompt for ${agent} (${file})"
    archive_prompt "${topic}"
    ;;

  hook )
    hook
    ;;

  --help | help | "" )
    show_usage
    ;;

  * )
    show_usage >&2
    exit 2
    ;;

esac
