#!/usr/bin/env bash
# Layout: [ ⚠ pontos ] ▶ [ location ] ▶ [ branch  git-status ] ▶ [ ✦ model ] ▶ [ context tokens % of reference ] ▶ [ session left % ↻ verdict % ] ▶ [ week left % ↻ verdict % ]

this_script_path="$(realpath "${0}")"
PATH="${this_script_path%/*}:${PATH}"

json_input=$(cat)

# --- Configuration ---

# Fixed segment backgrounds (256-color)
section_location_background_color=31 # dark blue
section_pontos_background_color=160   # red: a raw log is not on Drive (pontos-save status)
section_disk_warning_background_color=214  # amber: the disk passed the warning threshold (disk-watch status)
section_disk_critical_background_color=160 # red: the disk passed the critical threshold
section_branch_background_color=234  # #1c1c1c: the gray segments lighten from here to the last one
section_model_background_color=235   # #262626
section_tokens_background_color=236  # #303030, the context tokens and their share of the reference
section_limits_five_hour_background_color=237  # #3a3a3a, 5-hour usage limit
section_limits_seven_day_background_color=238  # #444444, 7-day usage limit

# With the nereus CLI installed (getnereus/nereus#1592), the weekly figures come from its local cache, read with jq
# on every render; claude-usage-plan and claude-usage-forecast stay as the fallback for a machine without it
nereus_usage_cache="${XDG_STATE_HOME:-${HOME}/.local/state}/nereus/usage/weekly.json"
nereus_usage=false
command -v nereus > /dev/null && nereus_usage=true

# One figure of the nereus cache (forecast), only when the cache holds the same window as the reading
nereus_figure() {
  local figure="${1?}"
  local resets_at="${2?}"

  [[ "${nereus_usage}" == true ]] || return
  jq --raw-output --argjson resets "${resets_at}" "
    def abs: if . < 0 then -. else . end;
    select(((.resetsAt // 0) - \$resets | abs) <= 60) | .figures.${figure} // empty
  " "${nereus_usage_cache}" 2>/dev/null
}

# Context: the tokens a session may reach before a save and /clear, and the thresholds over that reference (percentage)
context_tokens_reference=${CLAUDE_CONTEXT_TOKENS_REFERENCE:-300000}
context_threshold_critical=${CLAUDE_CONTEXT_THRESHOLD_CRITICAL:-80}
context_threshold_warning=${CLAUDE_CONTEXT_THRESHOLD_WARNING:-60}

# --- Git: repo name, folder, branch, status indicators ---
current_directory=$(echo "${json_input}" | jq --raw-output '.workspace.current_dir // ""')
project_directory=$(echo "${json_input}" | jq --raw-output '.workspace.project_dir // ""')

if [ -n "${project_directory}" ]; then
  project_name=$(basename "${project_directory}")
else
  project_name=$(basename "${current_directory}")
fi

if [ -n "${project_directory}" ] && [ "${current_directory}" != "${project_directory}" ]; then
  relative_subdirectory="${current_directory#"${project_directory}"/}"
  location="${project_name}/${relative_subdirectory}"
else
  location="${project_name}"
fi

git_root="${project_directory:-${current_directory}}"

git_branch=$(
  git \
    --no-optional-locks \
    --git-dir="${git_root}/.git" \
    rev-parse \
    --abbrev-ref HEAD 2>/dev/null || true
)

if [ -z "${git_branch}" ] && [ -n "${current_directory}" ]; then
  git_branch=$(git --no-optional-locks -C "${current_directory}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
fi

if [ -n "${git_branch}" ]; then
  # --bg restores segment bg after each color reset inside the indicators string
  git_indicators=$(git-status-indicators --dir "${git_root}" --color --bg "${section_branch_background_color}")

  if [ -n "${git_indicators}" ]; then
    section_branch_foreground_color='\033[38;5;247m'  # gray  — dirty
  else
    section_branch_foreground_color='\033[38;5;2m'    # green — clean
  fi
  
  branch_str=$(printf "${section_branch_foreground_color} \ue0a0 ${git_branch}\033[0m\033[48;5;${section_branch_background_color}m")
fi

# --- Context tokens against the reference ---
context_input_tokens=$(echo "${json_input}" | jq --raw-output '.context_window.total_input_tokens // 0')
context_used=$(( context_input_tokens * 100 / context_tokens_reference ))

if   [ "${context_used}" -ge "${context_threshold_critical}" ]; then context_color=203  # salmon
elif [ "${context_used}" -ge "${context_threshold_warning}"  ]; then context_color=221  # amber
else                                                               context_color=114  # green
fi

if [ "${context_input_tokens}" -ge 1000 ]; then
  context_tokens_display="$(( context_input_tokens / 1000 ))k"
else
  context_tokens_display="${context_input_tokens}"
fi

context_str=$(printf "\033[38;5;247m%s \033[38;5;${context_color}m%s%%" "${context_tokens_display}" "${context_used}")

# --- Model ---
model=$(echo "${json_input}" | jq --raw-output '.model.display_name // "N/A"')

# --- Account usage limits (5-hour session window, 7-day window) ---
# Absent for API-key accounts; the segment is omitted then.

# Prints the time left up to an epoch, such as 5d12h, 2h18m or 45m, or the fallback once it has passed
time_left() {
  local left=$(( ${1} - $(date +%s) ))

  if   [ "${left}" -le 0 ];     then echo "${2}"
  elif [ "${left}" -ge 86400 ]; then echo "$(( left / 86400 ))d$(( left % 86400 / 3600 ))h"
  elif [ "${left}" -ge 3600 ];  then echo "$(( left / 3600 ))h$(( left % 3600 / 60 ))m"
  else                               echo "$(( left / 60 ))m"
  fi
}

# The usage a window reaches at its reset at the current pace: the 7-day one from the nereus cache or
# claude-usage-forecast (none in the window's first 6 hours), the 5-hour one from the share of the window already gone
# (none in its first 30 minutes, when a few minutes would project far too high)
projection_percent() {
  local window="${1?}" used_exact="${2?}" resets_at="${3?}"
  local forecast signal

  if [[ "${window}" == seven_day ]]; then
    forecast=$(nereus_figure forecast "${resets_at}")
    [ -z "${forecast}" ] && read -r forecast signal < <(claude-usage-forecast --used "${used_exact}" --resets-at "${resets_at}" --with-percentage 2>/dev/null)
    [ -n "${forecast}" ] && awk --assign value="${forecast}" 'BEGIN { printf "%d", value + 0.5 }'
    return
  fi

  awk --assign used="${used_exact}" --assign resets="${resets_at}" --assign now="$(date +%s)" 'BEGIN {
    length_seconds = 5 * 3600
    elapsed = length_seconds - (resets - now)
    if (elapsed < 1800 || elapsed > length_seconds) exit
    printf "%d", used * length_seconds / elapsed + 0.5
  }'
}

# The verdict on a window's projection, as "icon color": the 5-hour window only has to last until its reset (ok up to
# 95%, slow above); the week aims to be used up, so it is ok up to 99%, slow above, and push below 70%, since the
# rest would be lost. The week's word comes from the nereus cache when it holds this window (getnereus/nereus spec
# 0015, one source of truth); the thresholds here are its fallback.
window_verdict() {
  local window="${1?}" projection="${2?}" resets_at="${3:-}" word=""

  [[ "${window}" == seven_day ]] && [ -n "${resets_at}" ] && word=$(nereus_figure pace "${resets_at}")
  case "${word}" in
    push)   echo "▲ 39";  return ;;
    steady) echo "• 114"; return ;;
    slow)   echo "▼ 203"; return ;;
    final)  echo "• 247"; return ;;  # no worked time left: neutral
  esac
  if [[ "${window}" == seven_day ]]; then
    if   [ "${projection}" -gt 99 ]; then echo "▼ 203"  # slow: salmon
    elif [ "${projection}" -lt 70 ]; then echo "▲ 39"   # push: blue
    else                                  echo "• 114"  # ok: green
    fi
  elif [ "${projection}" -gt 95 ]; then echo "▼ 203"    # slow: salmon
  else                                  echo "• 114"    # ok: green
  fi
}

# Prints a window as "time left, usage, reset, verdict and projection", as in 2h18m 42% ↻ 14:30 • 61%
limit_str() {
  local label="${1}" window="${2}" reset_format="${3}"
  local used used_exact resets_at reset_display="" projection verdict_display="" verdict_icon verdict_color

  used_exact=$(echo "${json_input}" | jq --raw-output ".rate_limits.${window}.used_percentage // empty")
  [ -z "${used_exact}" ] && return
  # Round up, to be cautious
  used=$(awk --assign value="${used_exact}" 'BEGIN { print (value == int(value)) ? value : int(value) + 1 }')
  resets_at=$(echo "${json_input}" | jq --raw-output ".rate_limits.${window}.resets_at // empty")
  if [ -n "${resets_at}" ]; then
    reset_display=" ↻ $(date --date "@${resets_at}" "+${reset_format}")"
    label=$(time_left "${resets_at}" "${label}")
  fi

  # The usage stays white: only the verdict and the projection carry a color
  if [ -n "${resets_at}" ]; then
    projection=$(projection_percent "${window}" "${used_exact}" "${resets_at}")
    if [ -n "${projection}" ]; then
      read -r verdict_icon verdict_color <<< "$(window_verdict "${window}" "${projection}" "${resets_at}")"
      verdict_display=" \033[38;5;${verdict_color}m${verdict_icon} ${projection}%"
      [[ "${window}" == seven_day ]] && verdict_display+="$(nereus_send_mark)"
    fi
  fi

  printf "\033[38;5;247m%s \033[38;5;255m%s%%\033[38;5;247m%s%b" "${label}" "${used}" "${reset_display}" "${verdict_display}"
}

# A salmon ! when the nereus CLI keeps failing to send the readings: the figure on the phone may be stale
nereus_send_mark() {
  if [[ "${nereus_usage}" == true ]] && [[ "$(jq --raw-output '.sendFailing // false' "${nereus_usage_cache}" 2>/dev/null)" == true ]]; then
    printf " \033[38;5;203m!"
  fi
}

# Save the weekly usage for claude-usage-plan, whatever segments are shown (the status line is the only place that receives it)
weekly_used=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.used_percentage // empty')
weekly_resets_at=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.resets_at // empty')

if [ -n "${weekly_used}" ] && [ -n "${weekly_resets_at}" ]; then
  weekly_cache_directory="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-status-line"
  mkdir --parents "${weekly_cache_directory}"
  jq --null-input \
    --argjson used "${weekly_used}" \
    --argjson resets_at "${weekly_resets_at}" \
    --argjson saved_at "$(date +%s)" \
    '{used_percentage: $used, resets_at: $resets_at, saved_at: $saved_at}' \
    > "${weekly_cache_directory}/weekly.json.$$" \
  && mv "${weekly_cache_directory}/weekly.json.$$" "${weekly_cache_directory}/weekly.json"

  # The first reading of each day is that day's starting point; noclobber keeps it when several sessions race
  weekly_history_directory="${weekly_cache_directory}/weekly-history"
  weekly_today=$(date +%F)
  if [ ! -f "${weekly_history_directory}/${weekly_today}.json" ]; then
    mkdir --parents "${weekly_history_directory}"
    (
      set -o noclobber
      jq --null-input --compact-output \
        --arg date "${weekly_today}" \
        --argjson used "${weekly_used}" \
        --argjson resets_at "${weekly_resets_at}" \
        --argjson saved_at "$(date +%s)" \
        '{date: $date, used_percentage: $used, resets_at: $resets_at, saved_at: $saved_at, source: "status-line"}' \
        > "${weekly_history_directory}/${weekly_today}.json"
    ) 2>/dev/null
  fi
fi

# Report the reading to Nereus through the nereus CLI, detached so the render never waits, only when the reading
# differs from its cache or the cache is 5 minutes old, and not within a minute of the last start; the CLI keeps the
# same limits, sends at most every 5 minutes and backs off on failure
if [[ "${nereus_usage}" == true ]] && [ -n "${weekly_used}" ] && [ -n "${weekly_resets_at}" ]; then
  nereus_usage_due=$(jq --raw-output \
    --argjson used "${weekly_used}" \
    --argjson resets "${weekly_resets_at}" \
    --argjson now "$(date +%s)" '
      def abs: if . < 0 then -. else . end;
      if (.lastStart // 0) > $now - 60 then "no"
      elif .used != $used or ((.resetsAt // 0) - $resets | abs) > 60 or (.computedAt // 0) <= $now - 300 then "yes"
      else "no" end
    ' "${nereus_usage_cache}" 2>/dev/null)
  if [[ "${nereus_usage_due:-yes}" == yes ]]; then
    setsid nereus usage report weekly \
      --used "${weekly_used}" \
      --resets-at "$(date --utc --date "@${weekly_resets_at}" +%FT%TZ)" \
      > /dev/null 2>&1 < /dev/null &
  fi
fi

# Which segments to show: both, session, weekly or none (set with claude-status-line-limits)
limits_choice=$(claude-status-line-limits)

limits_five_hour=""
limits_seven_day=""
[[ "${limits_choice}" == both || "${limits_choice}" == session ]] && limits_five_hour=$(limit_str "5h" five_hour "%H:%M")
[[ "${limits_choice}" == both || "${limits_choice}" == weekly  ]] && limits_seven_day=$(limit_str "7d" seven_day "%a %H:%M")

# Assemble segments with powerline separators
segment_separator=$'\ue0b0'
_last_segment_background=""

add_segment() {
  local background_color="" args=()

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --background ) background_color="${2}"; args+=("${1}" "${2}"); shift 2 ;;
      *            ) args+=("${1}");                                 shift   ;;
    esac
  done

  if [ -n "${_last_segment_background}" ] && [ "${_last_segment_background}" != "${background_color}" ]; then
    ansi-text \
      --text "${segment_separator}" \
      --background "${background_color}" \
      --foreground "${_last_segment_background}"
  fi

  ansi-text "${args[@]}"
  _last_segment_background="${background_color}"
}

end_segments() {
  printf "\033[0m\033[38;5;${_last_segment_background}m%s\033[0m" "${segment_separator}"
}

# Pontos (~/.claude/rules/pontos.md) raises this file when a raw log is blocked by its check or its upload failed
[ -f "${HOME}/.local/state/pontos/alert" ] && \
add_segment --text " ⚠ pontos " --background "${section_pontos_background_color}" --foreground 15 --bold

# disk-watch (scripts/utilities/disk-watch/README.md) writes this file while the disk is above its warning threshold
disk_alert_file="${XDG_STATE_HOME:-${HOME}/.local/state}/disk-watch/alert"
if [ -f "${disk_alert_file}" ]; then
  read -r disk_level disk_percent < <(jq --raw-output '"\(.level) \(.percent)"' "${disk_alert_file}" 2>/dev/null)
  if [ -n "${disk_percent}" ]; then
    if [ "${disk_level}" == "critical" ]; then
      add_segment --text " ⚠ disk ${disk_percent}% " --background "${section_disk_critical_background_color}" --foreground 15 --bold
    else
      add_segment --text " ⚠ disk ${disk_percent}% " --background "${section_disk_warning_background_color}" --foreground 0 --bold
    fi
  fi
fi

add_segment --text " ${location} " --background "${section_location_background_color}" --foreground 0 --bold

if [ -n "${git_branch}" ]; then
  add_segment --text "${branch_str} "     --background "${section_branch_background_color}"

  [ -n "${git_indicators}" ] && \
  add_segment --text "${git_indicators} " --background "${section_branch_background_color}"
fi

add_segment --text " ✦ ${model} " --background "${section_model_background_color}" --foreground 247
add_segment --text " ${context_str} " --background "${section_tokens_background_color}"
[ -n "${limits_five_hour}" ] && \
add_segment --text " ${limits_five_hour} "   --background "${section_limits_five_hour_background_color}"
[ -n "${limits_seven_day}" ] && \
add_segment --text " ${limits_seven_day} "   --background "${section_limits_seven_day_background_color}"

end_segments
