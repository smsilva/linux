#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

gh_hosts_file="${HOME}/.config/gh/hosts.yml"
gh_host="${GH_HOST:-github.com}"

if [[ ! -f "${gh_hosts_file}" ]]; then
  cat <<EOF

${gh_hosts_file} not found.

try:

  gh auth login

EOF

  exit 1
fi

active_account="$(yq --exit-status ".\"${gh_host}\".user" "${gh_hosts_file}" 2>/dev/null)"
git_protocol="$(yq ".\"${gh_host}\".git_protocol // \"unset\"" "${gh_hosts_file}")"
known_accounts="$(yq ".\"${gh_host}\".users | keys | join(\", \")" "${gh_hosts_file}")"
scopes="$(gh auth status --hostname "${gh_host}" 2>/dev/null \
  | awk -v account="${active_account}" '
      $0 ~ "account " account { found=1 }
      found && /Token scopes:/ {
        sub(/.*Token scopes: /, "")
        gsub(/'"'"'/, "")
        print
        exit
      }
    ')"

cat <<EOF
host..............: ${gh_host}
account...........: ${active_account}
git_protocol......: ${git_protocol}
scopes............: ${scopes}
known_accounts....: ${known_accounts}
EOF

echo ""

identity=$(gh api user --jq '[.login, .name, .html_url] | @tsv' 2>/dev/null)

result_code=${?}

if [[ ${result_code} -ne 0 ]]; then
  cat <<EOF

failed with exit code ${result_code}:

  gh api user

try:

  gh auth login --hostname ${gh_host}

EOF

  exit ${result_code}
fi

if [[ -n "${identity}" ]]; then
  IFS=$'\t' read -r login name html_url <<< "${identity}"
  cat <<EOF
login...: ${login}
name....: ${name}
url.....: ${html_url}
EOF
else
  echo "gh api user: ${identity}"
fi
