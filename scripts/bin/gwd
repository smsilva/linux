#!/bin/bash
this_script_path="$(realpath "${0}")"
this_script_name="${this_script_path##*/}"

show_usage() {
  cat <<EOF

  Remove a worktree of the current repository, and its branch, once its commits are on the trunk

    Options:

      -h,  --help         Show this help
      -k,  --keep-branch  Keep the worktree's branch (default: false)
      -f,  --force        Remove even when a tmux pane runs a program inside the worktree (default: false)
      -dr, --dry-run      Only show what would be removed (default: false)

    A tmux pane whose shell sits idle inside the worktree is moved to the main clone first;
    a pane running a program there (an agent, an editor) stops the removal, since keys sent
    to it would be typed into that program, and its shell would land in a removed folder.

    Examples:

      ${this_script_name}

      ${this_script_name} linux-gwd

      ${this_script_name} feat/gwd

      ${this_script_name} --dry-run
EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case "${1}" in
    -h | --help )
      show_usage
      exit 1
      ;;

    -k | --keep-branch )
      keep_branch=true
      ;;

    -f | --force )
      force=true
      ;;

    -dr | --dry-run )
      if [[ -n "${2}" && "${2}" =~ ^(true|false)$ ]]; then
        dry_run="${2}"
        shift
      else
        dry_run=true
      fi
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;

  esac
  shift
done

if [[ "${1}" == '--' ]]; then shift; fi

worktree_name="${1}"
dry_run="${dry_run:-false}"
keep_branch="${keep_branch:-false}"
force="${force:-false}"

# One line per worktree except the main one: path, branch (or detached), HEAD
list_worktrees() {
  git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); head = ""; branch = "(detached)" }
    /^HEAD /     { head = substr($2, 1, 7) }
    /^branch /   { branch = substr($2, 12) }
    /^$/         { if (count++ > 0) printf "%s\t%s\t%s\n", path, branch, head }
  '
}

# One line per tmux pane whose current folder is the worktree or inside it: pane id, its shell's pid, folder
panes_inside() {
  local root="${1}"

  command -v tmux > /dev/null || return 0
  tmux list-panes -a -F '#{pane_id}	#{pane_pid}	#{pane_current_path}' 2> /dev/null \
    | awk -F '\t' -v root="${root}" '$3 == root || index($3, root "/") == 1'
}

# A pane is idle when its process is a shell with no child: a prompt waiting for a command
pane_is_idle() {
  local pid="${1}"
  local name

  name="$(ps -o comm= --pid "${pid}" 2> /dev/null)"
  [[ "${name}" =~ ^-?(bash|zsh|sh|dash|fish)$ ]] || return 1
  [[ -z "$(ps -o pid= --ppid "${pid}" 2> /dev/null)" ]]
}

# What runs in a busy pane: its process and its children's names
pane_programs() {
  local pid="${1}"

  {
    ps -o comm= --pid "${pid}"
    ps -o comm= --ppid "${pid}"
  } 2> /dev/null | paste --serial --delimiters ','
}

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "Not inside a git repository"
  exit 1
fi

worktrees="$(list_worktrees)"

if [[ -z "${worktrees}" ]]; then
  echo "No worktrees besides the main one"
  git worktree list
  exit 0
fi

if [[ -z "${worktree_name}" ]]; then
  selected="$(column --table --separator $'\t' <<< "${worktrees}" | fzf)"
  worktree_path="$(awk '{ print $1 }' <<< "${selected}")"
else
  worktree_path="$(awk -F '\t' -v name="${worktree_name}" '
    {
      n = split($1, parts, "/")
      if ($1 == name || $2 == name || parts[n] == name) { print $1; exit }
    }
  ' <<< "${worktrees}")"
fi

if [[ -z "${worktree_path}" ]]; then
  [[ -n "${worktree_name}" ]] && echo "Worktree not found: ${worktree_name}"
  git worktree list
  exit 1
fi

line="$(awk -F '\t' -v path="${worktree_path}" '$1 == path' <<< "${worktrees}")"
branch="$(cut --fields 2 <<< "${line}")"

git fetch --quiet origin 2> /dev/null

trunk="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2> /dev/null)"
trunk="${trunk:-origin/main}"

# Every check fails closed: a git command that errors stops the removal
if ! git rev-parse --verify --quiet "${trunk}^{commit}" > /dev/null; then
  echo "Trunk not found: ${trunk}"
  exit 1
fi

if ! status="$(git -C "${worktree_path}" status --porcelain)"; then
  echo "Could not read the status of ${worktree_path}"
  exit 1
fi

if [[ -n "${status}" ]]; then
  echo "Uncommitted changes in ${worktree_path}:"
  git -C "${worktree_path}" status --short
  exit 1
fi

if ! head="$(git -C "${worktree_path}" rev-parse --verify HEAD)" || [[ -z "${head}" ]]; then
  echo "Could not read the HEAD of ${worktree_path}"
  exit 1
fi

# git cherry marks with "+" the commits whose change is not on the trunk;
# it compares patches, so it also sees commits a rebase merge rewrote
if ! cherry="$(git cherry -v "${trunk}" "${head}")"; then
  echo "git cherry failed for ${trunk} and ${head}"
  exit 1
fi

missing="$(grep '^+' <<< "${cherry}")"

if [[ -n "${missing}" ]]; then
  echo "Commits of ${worktree_path} (${branch}) not on ${trunk}:"
  echo "${missing}"
  exit 1
fi

main_clone="$(git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }')"

idle_panes=()
busy_panes=()

while IFS=$'\t' read -r pane_id pane_pid pane_path; do
  [[ -z "${pane_id}" ]] && continue
  if pane_is_idle "${pane_pid}"; then
    idle_panes+=("${pane_id}")
  else
    busy_panes+=("${pane_id} ($(pane_programs "${pane_pid}")) in ${pane_path}")
  fi
done <<< "$(panes_inside "${worktree_path}")"

if [[ "${#busy_panes[@]}" -gt 0 && "${force}" == "false" ]]; then
  echo "tmux panes run a program inside ${worktree_path}:"
  printf '  %s\n' "${busy_panes[@]}"
  echo "Leave the program and the folder in those panes, or pass --force to remove anyway"
  exit 1
fi

echo "Worktree: ${worktree_path}"
echo "Branch:   ${branch}"
echo "Commits:  all on ${trunk}"

if [[ "${#idle_panes[@]}" -gt 0 ]]; then
  echo "Panes:    ${idle_panes[*]} move to ${main_clone}"
fi

if [[ "${#busy_panes[@]}" -gt 0 ]]; then
  echo "Panes:    left in a removed folder (--force):"
  printf '            %s\n' "${busy_panes[@]}"
fi

if [[ "${dry_run}" == "true" ]]; then
  echo ""
  echo "Dry run: nothing removed"
  exit 0
fi

for pane_id in "${idle_panes[@]}"; do
  tmux send-keys -t "${pane_id}" -l "cd ${main_clone@Q}"
  tmux send-keys -t "${pane_id}" Enter
done

git worktree remove "${worktree_path}" || exit 1

if [[ "${keep_branch}" == "false" && "${branch}" != "(detached)" ]]; then
  # --force: a rebase merge rewrites the commits, so plain --delete refuses
  # a branch whose content git cherry already found on the trunk
  git branch --delete --force "${branch}"
fi

echo ""
git worktree list
