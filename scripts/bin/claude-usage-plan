#!/bin/bash
this_script_path="$(realpath "${0}")"
this_script_name="${this_script_path##*/}"

cache_file="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-status-line/weekly.json"
history_directory="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-status-line/weekly-history"

show_usage() {
  cat <<EOF

  Shows the days already gone of the weekly Claude quota, from the first
  reading of each day saved by claude-status-line (~ marks an estimate between
  known points), and plans the rest: for each remaining day, the
  cumulative percentage to reach by the end of that day (and the share of
  that day), so the whole quota is used by the reset without running out
  before it. The budget is spread evenly over the time left.

  Reads the last weekly usage saved by claude-status-line in
  ${cache_file}
  unless --used and --resets-at are given.

    Options:

      -h,  --help       Show this help
      -u,  --used       Percentage of the window used so far
      -r,  --resets-at  Epoch seconds of the window's reset
      -t,  --target     Percentage to reach at the reset (default: 100)
      -n,  --now        Epoch seconds of the current time (default: the clock)
           --today-goal Print only the percentage to reach by the end of today

    Examples:

      ${this_script_name}

      ${this_script_name} --target 95

      ${this_script_name} --today-goal

      ${this_script_name} --used 30 --resets-at 1794186000

EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case "${1}" in
    -h | --help )
      show_usage
      exit 1
      ;;

    -u | --used )
      shift
      used="${1}"
      ;;

    -r | --resets-at )
      shift
      resets_at="${1}"
      ;;

    -t | --target )
      shift
      target="${1}"
      ;;

    -n | --now )
      shift
      now="${1}"
      ;;

    --today-goal )
      today_goal=true
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage >&2
      exit 1
      ;;

  esac
  shift
done

now="${now:-$(date +%s)}"
target="${target:-100}"

if [[ -z "${used}" && -z "${resets_at}" ]]; then
  if [[ ! -f "${cache_file}" ]]; then
    echo "No saved usage in ${cache_file}: wait for the status line to refresh, or pass --used and --resets-at" >&2
    exit 1
  fi

  used=$(jq --raw-output '.used_percentage' "${cache_file}")
  resets_at=$(jq --raw-output '.resets_at' "${cache_file}")
  saved_at=$(jq --raw-output '.saved_at // empty' "${cache_file}")
fi

if ! [[ "${used}" =~ ^[0-9]+(\.[0-9]+)?$ && "${target}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
  echo "--used and --target must be percentages: '${used}' '${target}'" >&2
  exit 1
fi

for epoch in "${resets_at}" "${now}"; do
  if ! [[ "${epoch}" =~ ^[0-9]+$ ]]; then
    echo "--resets-at and --now must be epoch seconds: '${epoch}'" >&2
    exit 1
  fi
done

if [[ "${now}" -ge "${resets_at}" ]]; then
  echo "The window reset at $(date --date "@${resets_at}" '+%a %d %H:%M'): the saved usage is stale, wait for the status line to refresh" >&2
  exit 1
fi

used_display=$(awk --assign value="${used}" 'BEGIN { print (value == int(value)) ? value : int(value) + 1 }')

# Prints the end of the plan's day that holds an epoch
plan_day_end() {
  local day_end
  day_end=$(date --date "$(date --date "@${1}" '+%F') +1 day" '+%s')
  # The hours after midnight before the reset still belong to the last day
  [[ $(( resets_at - day_end )) -lt $(( 6 * 3600 )) ]] && day_end="${resets_at}"
  echo "${day_end}"
}

# Prints the cumulative percentage to reach by an epoch, and the share over the previous one
plan_cumulative() {
  awk \
    --assign used="${used}" \
    --assign target="${target}" \
    --assign previous="${2}" \
    --assign now="${now}" \
    --assign end="${1}" \
    --assign reset="${resets_at}" \
    'BEGIN {
      cumulative = used + (target - used) * (end - now) / (reset - now)
      if (cumulative < used) cumulative = used
      # Round down, to be cautious (the last day lands on the target)
      cumulative = (end == reset) ? target : int(cumulative)
      if (cumulative < previous) cumulative = previous
      printf "%.0f %.0f\n", cumulative, cumulative - previous
    }'
}

if [[ "${today_goal}" == true ]]; then
  read -r cumulative _ < <(plan_cumulative "$(plan_day_end "${now}")" "${used_display}")
  echo "${cumulative}"
  exit 0
fi

echo
echo "  Weekly quota: ${used_display}% used, resets $(date --date "@${resets_at}" '+%a %d/%m %H:%M'), target ${target}%"
if [[ -n "${saved_at}" ]]; then
  echo "  Usage read at $(date --date "@${saved_at}" '+%a %H:%M')"
fi
echo
printf '  %-18s %-8s %10s %12s\n' "Day" "Ends" "Day share" "Cumulative"

# Known points of the window as "epoch percentage": its start at 0, each day's first reading placed at that day's midnight, and now
window_start=$(( resets_at - 7 * 24 * 3600 ))
points="${window_start} 0"

for snapshot in "${history_directory}"/*.json; do
  [[ -f "${snapshot}" ]] || continue
  read -r snapshot_date snapshot_used snapshot_saved_at < <(jq --raw-output '"\(.date) \(.used_percentage) \(.saved_at)"' "${snapshot}")
  [[ "${snapshot_saved_at}" -ge "${window_start}" && "${snapshot_saved_at}" -le "${now}" ]] || continue
  snapshot_epoch=$(date --date "${snapshot_date}" '+%s')
  # A first reading on the reset's own day comes after the window started, so it keeps its own time
  [[ "${snapshot_epoch}" -lt "${window_start}" ]] && snapshot_epoch="${snapshot_saved_at}"
  points+=$'\n'"${snapshot_epoch} ${snapshot_used}"
done

points+=$'\n'"${now} ${used}"
points=$(sort --numeric-sort --key 1,1 <<< "${points}")

# Prints the usage at an epoch, interpolated between the known points, rounded up, followed by 1 when it is an estimate
usage_at() {
  awk \
    --assign at="${1}" \
    '{ time[NR] = $1; value[NR] = $2 }
    END {
      estimate = 1
      for (i = 1; i <= NR; i++) {
        if (time[i] == at) { result = value[i]; estimate = 0 }
      }
      if (estimate) {
        for (i = 1; i < NR; i++) {
          if (time[i] < at && at < time[i + 1]) {
            result = value[i] + (value[i + 1] - value[i]) * (at - time[i]) / (time[i + 1] - time[i])
          }
        }
      }
      printf "%d %d\n", (result == int(result)) ? result : int(result) + 1, estimate
    }' <<< "${points}"
}

today_start=$(date --date "$(date --date "@${now}" '+%F')" '+%s')
[[ "${today_start}" -lt "${window_start}" ]] && today_start="${window_start}"

previous=0
day_start="${window_start}"

while [[ "${day_start}" -lt "${today_start}" ]]; do
  day_end=$(date --date "$(date --date "@${day_start}" '+%F') +1 day" '+%s')
  read -r cumulative estimate < <(usage_at "${day_end}")
  mark=""
  [[ "${estimate}" == 1 ]] && mark="~"

  printf '  %-18s %-8s %9s%% %11s%%\n' \
    "$(date --date "@${day_start}" '+%a %d/%m')" \
    "$(date --date "@${day_end}" '+%H:%M')" \
    "${mark}+$(( cumulative - previous ))" \
    "${mark}${cumulative}"

  previous="${cumulative}"
  day_start="${day_end}"
done

printf '  %-18s %-8s %9s%% %11s%%\n' \
  "$(date --date "@${now}" '+%a %d/%m') (so far)" \
  "$(date --date "@${now}" '+%H:%M')" \
  "+$(( used_display - previous ))" \
  "${used_display}"

previous="${used_display}"
day_start="${now}"

while [[ "${day_start}" -lt "${resets_at}" ]]; do
  day_end=$(plan_day_end "${day_start}")

  label=$(date --date "@${day_start}" '+%a %d/%m')
  [[ "${day_start}" == "${now}" ]] && label="${label} (today)"

  read -r cumulative share < <(plan_cumulative "${day_end}" "${previous}")

  printf '  %-18s %-8s %9s%% %11s%%\n' \
    "${label}" \
    "$(date --date "@${day_end}" '+%H:%M')" \
    "+${share}" \
    "${cumulative}"

  previous="${cumulative}"
  day_start="${day_end}"
done

echo
