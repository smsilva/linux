#!/usr/bin/env python3
"""The facts of a repository at the end of a session, for the wrap-up skill: what is left uncommitted, unpushed,
unmerged or blocked. It reads only and changes nothing.

Sources: git (the working tree, the worktrees, the local branches and how far they are on origin), gh (the pull
requests of those branches), the project's board (`scripts/board/queue mine` and `next`, when the repository has one;
the current issue, the sequence it starts and whether the next one follows it), the project's
own skills (`issue`, `handoff`) and Pontos (`pontos-save status`). Each source fails on its own and reads
`unavailable: <reason>`; the script exits 0 whenever it printed facts.

Several sessions share one gh account, so the board's "mine" holds every session's issues. Inside Claude Code
($CLAUDE_CODE_SESSION_ID, or --session), the tool calls of this session and its subagents (their inputs only, never
the outputs) tell this session's worktrees and issues from another session's.
"""
import argparse
import concurrent.futures
import datetime
import json
import os
import pathlib
import re
import shutil
import subprocess

TRUNKS = {"main", "master"}
# The board script lives in the repository, so it runs only where origin belongs to the owner (as Pontos's opt-in).
TRUSTED_OWNERS = {"smsilva", "getnereus", "wasp-foundry"}
# Only github.com, as scp (git@github.com:o/r) or URL (https:// or ssh://git@); anything else (another host, a local
# path, a query) has no owner.
GITHUB = re.compile(r"(?:git@github\.com:|(?:https|ssh)://(?:git@)?github\.com/)([A-Za-z0-9-]+)/[A-Za-z0-9._-]+?(?:\.git)?/?")


class Unavailable(Exception):
  pass


def run(*command, cwd, timeout=60):
  try:
    result = subprocess.run(command, cwd=cwd, capture_output=True, text=True, timeout=timeout)
  except (OSError, subprocess.TimeoutExpired) as error:
    raise Unavailable(f"{command[0]}: {error.__class__.__name__}") from error
  if result.returncode != 0:
    last = (result.stderr or result.stdout).strip().splitlines()
    raise Unavailable(f"{' '.join(command[:3])}: {last[-1] if last else 'failed'}")
  return result.stdout


def git(*args, cwd):
  return run("git", *args, cwd=cwd)


def changes(path):
  """How many files differ from HEAD in a checkout (staged, unstaged or untracked)."""
  return len([line for line in git("status", "--porcelain", cwd=path).splitlines() if line.strip()])


def merged(repo, branch):
  """True when every commit of the branch is on origin's trunk (rebase merges rewrite SHAs, so git cherry)."""
  trunk = default_trunk(repo)
  return not any(line.startswith("+") for line in git("cherry", f"origin/{trunk}", branch, cwd=repo).splitlines())


def default_trunk(repo):
  try:
    return git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=repo).strip().removeprefix("origin/")
  except Unavailable:
    return "main"


def repository(repo):
  top = pathlib.Path(git("rev-parse", "--show-toplevel", cwd=repo).strip())
  common = pathlib.Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=repo).strip())
  return {
    "name": common.parent.name,
    "path": str(top),
    "branch": git("branch", "--show-current", cwd=repo).strip() or "(detached)",
    "changes": changes(top),
    "trunk": default_trunk(repo),
  }


def worktrees(repo):
  found, current = [], {}
  for line in git("worktree", "list", "--porcelain", cwd=repo).splitlines() + [""]:
    if line.startswith("worktree "):
      current = {"path": line.split(" ", 1)[1]}
    elif line.startswith("branch "):
      current["branch"] = line.split(" ", 1)[1].removeprefix("refs/heads/")
    elif not line and current:
      found.append(current)
      current = {}
  for tree in found[1:]:  # the first one is the main clone
    tree["changes"] = changes(tree["path"]) if pathlib.Path(tree["path"]).exists() else None
    branch = tree.get("branch")
    tree["merged"] = bool(branch) and branch not in TRUNKS and merged(repo, branch)
  return found[1:]


def branches(repo):
  found = []
  out = git("for-each-ref", "--format=%(refname:short)\t%(upstream:short)\t%(upstream:track)", "refs/heads", cwd=repo)
  for line in out.splitlines():
    name, upstream, track = (line.split("\t") + ["", ""])[:3]
    if name in TRUNKS or name.startswith("backup/"):
      continue
    if not upstream:
      state = "not pushed"
    elif "gone" in track:
      state = "upstream gone"
    elif "ahead" in track:
      state = f"pushed, {track.strip('[]')}"
    else:
      state = "pushed"
    found.append({"name": name, "state": state, "merged": merged(repo, name)})
  return found


def pull_requests(repo, names):
  if not names or not shutil.which("gh"):
    raise Unavailable("no branches" if not names else "gh not installed")
  out = run("gh", "pr", "list", "--state", "all", "--limit", "200",
            "--json", "number,title,state,headRefName", cwd=repo)
  latest = {}
  for pr in json.loads(out):
    if pr["headRefName"] in names and pr["headRefName"] not in latest:
      latest[pr["headRefName"]] = {"number": pr["number"], "title": pr["title"], "state": pr["state"]}
  return latest


def origin_owner(repo):
  """The owner in origin's URL (git@github.com:<owner>/<repo>.git or https://github.com/<owner>/<repo>)."""
  try:
    url = git("remote", "get-url", "origin", cwd=repo).strip()
  except Unavailable:
    return None
  found = GITHUB.fullmatch(url)
  return found.group(1) if found else None


def trusted_queue(repo):
  queue = pathlib.Path(repo) / "scripts/board/queue"
  if not queue.exists():
    raise Unavailable("no board (scripts/board/queue)")
  if origin_owner(repo) not in TRUSTED_OWNERS:
    raise Unavailable("board not trusted (origin is not one of the owner's)")
  return str(queue)


def session_commands(session_id=None, home=None):
  """The input of every tool call of a Claude Code session and its subagents, as JSON text; None when the session or
  its transcript is unknown. Outputs are left out: they also name other sessions' work."""
  session_id = session_id or os.environ.get("CLAUDE_CODE_SESSION_ID")
  if not session_id:
    return None
  transcripts = list(((home or pathlib.Path.home()) / ".claude/projects").glob(f"*/{session_id}.jsonl"))
  if not transcripts:
    return None
  files = transcripts + [path for found in transcripts for path in (found.parent / session_id / "subagents").glob("*.jsonl")]
  commands = []
  for path in files:
    with path.open(errors="replace") as lines:
      for line in lines:
        try:
          entry = json.loads(line)
        except ValueError:
          continue
        content = (entry.get("message") or {}).get("content") if isinstance(entry, dict) else None
        if entry.get("type") != "assistant" or not isinstance(content, list):
          continue
        commands += [json.dumps(block.get("input", {}), ensure_ascii=False) for block in content
                     if isinstance(block, dict) and block.get("type") == "tool_use"]
  return commands


def mine_worktree(path, repo_name, commands):
  """True when this session wrote in the worktree: created it (`worktree/new <type> <slug>`, `worktree add`), edited a
  file in it, or added, committed or pushed there (`git -C <path>`, `cd <path>`). Reading it or naming it does not
  count."""
  name = pathlib.Path(path).name
  slug = re.escape(name.removeprefix(f"{repo_name}-"))
  where = re.escape(path)
  wrote = re.compile(rf'"file_path": "{where}/|worktree/new\s+\S+\s+{slug}\b|worktree add\s+(?:--?\S+\s+)*\S*{re.escape(name)}\b'
                     rf"|git -C {where} (?:add|commit|push)\b|cd {where}\b[^\"]*\bgit (?:add|commit|push)\b")
  return any(wrote.search(command) for command in commands)


def claimed(number, commands):
  """True when this session claimed the issue (`queue claim <n>`, or `queue status <n> "In Progress"`)."""
  pattern = re.compile(rf"queue\s+(?:claim\s+{number}\b|status\s+{number}\s+\\?[\"']?In Progress)")
  return any(pattern.search(command) for command in commands)


def closed_here(number, commands):
  """True when this session claimed the issue, closed it (`gh issue close <n>`, also in a `for` loop over numbers) or
  wrote `Closes #<n>`."""
  closes = re.compile(rf"closes\s+#{number}\b|gh issue close\s+#?{number}\b"
                      rf"|for \w+ in [^;]*\b{number}\b[^;]*;\s*do\b[^\"]*gh issue close\b", re.IGNORECASE)
  return claimed(number, commands) or any(closes.search(command) for command in commands)


def board(repo):
  """Mine (`queue mine`) and the next issue (`queue next`), both read only and slow (the board's API), run at once."""
  queue = trusted_queue(repo)
  with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
    mine, upcoming = pool.submit(run, queue, "mine", cwd=repo), pool.submit(run, queue, "next", cwd=repo)
    return {"mine": mine.result(), "next": upcoming.result()}


def numbered(lines):
  """The issues in `queue` lines (`Todo  #488  <title>`), as {number, title}."""
  found = []
  for line in lines.splitlines():
    match = re.search(r"#(\d+)\s+(.*)$", line)
    if match:
      found.append({"number": int(match.group(1)), "title": clean(match.group(2).strip())})
  return found


# Who may put an issue in a sequence: an issue of a public repository can be opened by anyone, and its title reaches
# the agent's context, so only the repository's own people count.
TRUSTED_AUTHORS = {"OWNER", "MEMBER", "COLLABORATOR"}


def clean(title):
  """An issue title as data: no control characters, at most 120 characters."""
  title = "".join(char for char in title if char.isprintable())
  return title if len(title) <= 120 else title[:119] + "…"


def sequence(repo, slug, number, body):
  """The open issues that follow one: its `Blocks #n`, the open issues that say `Depends on #<it>`, and the open
  sub-issues of its parent; each one opened by the repository's own people (TRUSTED_AUTHORS)."""
  candidates = set()
  for line in body.splitlines():
    if re.match(r"\W*blocks\b", line, re.IGNORECASE):
      candidates.update(int(n) for n in re.findall(r"#(\d+)", line))
  out = run("gh", "issue", "list", "--state", "open", "--limit", "50", "--search", f'"Depends on #{number}" in:body',
            "--json", "number,body", cwd=repo)
  for found in json.loads(out):
    if re.search(rf"depends on\b[^\n]*#{number}\b", found["body"], re.IGNORECASE):
      candidates.add(found["number"])
  owner, name = slug.split("/")
  fields = "number title state authorAssociation"
  query = (f'query($n:Int!){{repository(owner:"{owner}",name:"{name}"){{issue(number:$n){{parent{{subIssues(first:50)'
           f"{{nodes{{{fields}}}}}}}}}}}}}")
  data = json.loads(run("gh", "api", "graphql", "-F", f"n={number}", "-f", f"query={query}", cwd=repo))
  parent = data["data"]["repository"]["issue"]["parent"]
  found = {node["number"]: node for node in (parent or {}).get("subIssues", {}).get("nodes", [])}
  missing = sorted(candidates - set(found))
  if missing:
    aliases = " ".join(f"i{key}:issue(number:{key}){{{fields}}}" for key in missing)
    query = f'{{repository(owner:"{owner}",name:"{name}"){{{aliases}}}}}'
    data = json.loads(run("gh", "api", "graphql", "-f", f"query={query}", cwd=repo))
    found.update({node["number"]: node for node in data["data"]["repository"].values() if node})
  return [{"number": key, "title": clean(node["title"])} for key, node in sorted(found.items())
          if key != number and node["state"] == "OPEN" and node["authorAssociation"] in TRUSTED_AUTHORS]


WITHHELD = "(title withheld: external author)"


def vet(repo, slug, listed):
  """Replaces the title of every issue whose author is not the repository's own people (TRUSTED_AUTHORS) with
  WITHHELD, in place: one GraphQL query for all of them."""
  numbers = sorted({issue["number"] for issue in listed})
  if not numbers:
    return
  owner, name = slug.split("/")
  aliases = " ".join(f"i{key}:issue(number:{key}){{number authorAssociation}}" for key in numbers)
  data = json.loads(run("gh", "api", "graphql", "-f", f'query={{repository(owner:"{owner}",name:"{name}"){{{aliases}}}}}',
                        cwd=repo))
  trusted = {node["number"] for node in data["data"]["repository"].values()
             if node and node["authorAssociation"] in TRUSTED_AUTHORS}
  for issue in listed:
    if issue["number"] not in trusted:
      issue["title"] = WITHHELD


def issues(repo, queues, commands=None):
  """The current issues (mine In Progress, and those I closed today), the sequence each one starts, and the next
  issue after a /clear (`queue next`, read only), flagged when it leaves a sequence. With this session's commands
  (session_commands), each issue says whether this session or another one holds it, and the next one is flagged when
  another session holds it."""
  if not shutil.which("gh"):
    raise Unavailable("gh not installed")
  def whose(issue, test):
    return None if commands is None else "this" if test(issue["number"], commands) else "another"

  current = [dict(issue, state="in progress") for issue in numbered(queues["mine"])]
  for issue in current:
    issue["session"] = whose(issue, claimed)
  today = datetime.date.today().isoformat()
  out = run("gh", "issue", "list", "--state", "closed", "--limit", "20", "--search", f"assignee:@me closed:>={today}",
            "--json", "number,title", cwd=repo)
  closed = [{"number": issue["number"], "title": clean(issue["title"]), "state": "closed today"}
            for issue in json.loads(out)]
  for issue in closed:
    issue["session"] = whose(issue, closed_here)
  current += closed
  slug = run("gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner", cwd=repo).strip()

  def follow(issue):
    if issue["session"] == "another":
      issue["sequence"] = []
      return
    body = json.loads(run("gh", "issue", "view", str(issue["number"]), "--json", "body", cwd=repo))["body"]
    issue["sequence"] = sequence(repo, slug, issue["number"], body)

  with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
    list(pool.map(follow, current))
  following = numbered(queues["next"])
  upcoming = following[0] if following else None
  vet(repo, slug, current + ([upcoming] if upcoming else []))
  expected = {follow["number"] for issue in current for follow in issue["sequence"]}
  elsewhere = {issue["number"] for issue in current if issue["state"] == "in progress" and issue["session"] == "another"}
  return {
    "current": current,
    "next": upcoming,
    "next_held_elsewhere": bool(upcoming) and upcoming["number"] in elsewhere,
    "off_sequence": bool(expected) and (upcoming is None or upcoming["number"] not in expected),
  }


def skills(repo):
  folder = pathlib.Path(repo) / ".claude/skills"
  return {name: "project" if (folder / name / "SKILL.md").exists() else "global" for name in ("issue", "handoff")}


def pontos(repo):
  """The sessions whose raw log is not on Drive, each with its details (what the check flagged)."""
  if not shutil.which("pontos-save"):
    raise Unavailable("pontos-save not installed")
  problems = []
  for line in run("pontos-save", "status", "--limit", "10", cwd=repo).splitlines():
    if not line.startswith(" "):
      problems.append(" ".join(line.split()) if "on Drive" not in line else None)
    elif problems and problems[-1]:
      problems[-1] += f"; {line.strip()}"
  return [problem for problem in problems if problem]


def facts(repo, session=None):
  report = {}
  commands = session_commands(session)

  def gather(key, source, *args):
    try:
      report[key] = source(*args)
    except Unavailable as error:
      report[key] = {"unavailable": str(error)}

  gather("repository", repository, repo)
  if "unavailable" in report["repository"]:
    return report
  top = report["repository"]["path"]
  gather("worktrees", worktrees, top)
  if commands is not None and isinstance(report["worktrees"], list):
    for tree in report["worktrees"]:
      tree["session"] = "this" if mine_worktree(tree["path"], report["repository"]["name"], commands) else "another"
  gather("branches", branches, top)
  names = [branch["name"] for branch in report["branches"]] if isinstance(report["branches"], list) else []
  gather("pull_requests", pull_requests, top, names)
  gather("board", board, top)
  queues = report.pop("board")
  if "unavailable" in queues:
    report["board"] = report["issues"] = queues
  else:
    report["board"] = [line.strip() for line in queues["mine"].splitlines() if line.strip()]
    gather("issues", issues, top, queues, commands)
    if commands is not None:
      report["board"] = [line if not numbered(line) or claimed(numbered(line)[0]["number"], commands)
                         else f"{line} (another session)" for line in report["board"]]
  gather("skills", skills, top)
  gather("pontos", pontos, top)
  return report


def text(report):
  def unavailable(value):
    return isinstance(value, dict) and "unavailable" in value

  lines = []
  repo = report["repository"]
  if unavailable(repo):
    return f"repository: unavailable: {repo['unavailable']}"
  lines.append(f"repository: {repo['name']} ({repo['path']}), on {repo['branch']}, "
               f"{repo['changes'] or 'no'} uncommitted change(s)")
  for key, label in (("worktrees", "worktrees"), ("branches", "branches"), ("pull_requests", "pull requests"),
                     ("board", "board, mine"), ("pontos", "pontos")):
    value = report[key]
    if unavailable(value):
      lines.append(f"{label}: unavailable: {value['unavailable']}")
      continue
    lines.append(f"{label}: {len(value) or 'none'}")
    if key == "worktrees":
      for tree in value:
        flags = [f"{tree['changes']} uncommitted" if tree["changes"] else "clean"]
        flags += ["merged on the trunk"] if tree["merged"] else []
        flags += [f"{tree['session']} session"] if tree.get("session") else []
        lines.append(f"  {tree['path']} [{tree.get('branch', 'detached')}] {', '.join(flags)}")
    elif key == "branches":
      for branch in value:
        lines.append(f"  {branch['name']}: {branch['state']}{', merged on the trunk' if branch['merged'] else ''}")
    elif key == "pull_requests":
      for name, pr in value.items():
        lines.append(f"  {name}: #{pr['number']} {pr['state']} ({pr['title']})")
    else:
      lines.extend(f"  {line}" for line in value)
  found = report.get("issues")
  if unavailable(found):
    lines.append(f"issues: unavailable: {found['unavailable']}")
  elif found is not None:
    lines.append("issues:")
    elsewhere = [issue for issue in found["current"]
                 if issue.get("session") == "another" and issue["state"] == "closed today"]
    shown = [issue for issue in found["current"] if issue not in elsewhere]
    for issue in shown or [{"number": None}]:
      if issue["number"] is None:
        lines.append("  current: none")
        continue
      state = issue["state"] + (", another session" if issue.get("session") == "another" else "")
      lines.append(f"  current: #{issue['number']} ({state}) {issue['title']}")
      for follow in issue["sequence"]:
        lines.append(f"    then: #{follow['number']} {follow['title']}")
    if elsewhere:
      lines.append(f"  closed today by other sessions: {len(elsewhere)}")
    upcoming = found["next"]
    lines.append(f"  next: #{upcoming['number']} {upcoming['title']}" if upcoming else "  next: none")
    if found["off_sequence"]:
      lines.append("  warning: the next issue does not follow the sequence of the current one(s)")
    if found.get("next_held_elsewhere"):
      lines.append("  warning: the next issue is held by another session (one gh account): /next <number> or --new")
  skill = report["skills"]
  lines.append("skills: " + ", ".join(f"{name} {where}" for name, where in skill.items()))
  return "\n".join(lines)


def main():
  parser = argparse.ArgumentParser(description="The facts of a repository at the end of a session (read only).")
  parser.add_argument("--repo", default=".", help="A path inside the repository (default: the current folder).")
  parser.add_argument("--json", action="store_true", help="Print JSON instead of text.")
  parser.add_argument("--session", help="The Claude Code session id (default: $CLAUDE_CODE_SESSION_ID).")
  args = parser.parse_args()
  report = facts(str(pathlib.Path(args.repo).resolve()), args.session)
  print(json.dumps(report, indent=2) if args.json else text(report))


if __name__ == "__main__":
  main()
