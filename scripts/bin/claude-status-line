#!/usr/bin/env bash
# Layout: [ ⚠ pontos ] ▶ [ location ] ▶ [ branch  git-status ] ▶ [ context% ] ▶ [ session left % ↻ ] ▶ [ week left % ↻ ] ▶ [ today % of goal ] ▶ [ forecast % signal ] ▶ [ ◔ time ] ▶ [ model ] ▶ [ ◈ tokens ]

this_script_path="$(realpath "${0}")"
PATH="${this_script_path%/*}:${PATH}"

json_input=$(cat)

# --- Configuration ---

# Fixed segment backgrounds (256-color)
section_location_background_color=31 # dark blue
section_pontos_background_color=160   # red: a raw log is not on Drive (pontos-save status)
section_disk_warning_background_color=214  # amber: the disk passed the warning threshold (disk-watch status)
section_disk_critical_background_color=160 # red: the disk passed the critical threshold
section_branch_background_color=236  # #303030
section_turns_background_color=235   # #262626, dark gray
section_model_background_color=238   # #444444
section_tokens_background_color=244  # #808080, lighter than model
section_limits_five_hour_background_color=237  # #3a3a3a, 5-hour usage limit
section_limits_seven_day_background_color=239  # #4e4e4e, 7-day usage limit
section_limits_today_background_color=235      # #262626, today's goal
section_limits_forecast_background_color=237   # #3a3a3a, the week's forecast and signal

# Account usage limit thresholds (percentage)
limits_threshold_critical=${CLAUDE_LIMITS_THRESHOLD_CRITICAL:-80}
limits_threshold_warning=${CLAUDE_LIMITS_THRESHOLD_WARNING:-50}

# Context window thresholds (percentage)
context_threshold_critical=${CLAUDE_CONTEXT_THRESHOLD_CRITICAL:-70}
context_threshold_warning=${CLAUDE_CONTEXT_THRESHOLD_WARNING:-50}

# Session time thresholds (seconds)
session_duration_seconds_threshold_critical=$(( ${CLAUDE_SESSION_DURATION_SECONDS_THRESHOLD_CRITICAL:-35} * 60 ))
session_duration_seconds_threshold_warning=$(( ${CLAUDE_SESSION_DURATION_SECONDS_THRESHOLD_WARNING:-25} * 60 ))
session_duration_seconds_threshold_caution=$(( ${CLAUDE_SESSION_DURATION_SECONDS_THRESHOLD_CAUTION:-15} * 60 ))

# --- Git: repo name, folder, branch, status indicators ---
current_directory=$(echo "${json_input}" | jq --raw-output '.workspace.current_dir // ""')
project_directory=$(echo "${json_input}" | jq --raw-output '.workspace.project_dir // ""')

if [ -n "${project_directory}" ]; then
  project_name=$(basename "${project_directory}")
else
  project_name=$(basename "${current_directory}")
fi

if [ -n "${project_directory}" ] && [ "${current_directory}" != "${project_directory}" ]; then
  relative_subdirectory="${current_directory#"${project_directory}"/}"
  location="${project_name}/${relative_subdirectory}"
else
  location="${project_name}"
fi

git_root="${project_directory:-${current_directory}}"

git_branch=$(
  git \
    --no-optional-locks \
    --git-dir="${git_root}/.git" \
    rev-parse \
    --abbrev-ref HEAD 2>/dev/null || true
)

if [ -z "${git_branch}" ] && [ -n "${current_directory}" ]; then
  git_branch=$(git --no-optional-locks -C "${current_directory}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
fi

if [ -n "${git_branch}" ]; then
  # --bg restores segment bg after each color reset inside the indicators string
  git_indicators=$(git-status-indicators --dir "${git_root}" --color --bg "${section_branch_background_color}")

  if [ -n "${git_indicators}" ]; then
    section_branch_foreground_color='\033[38;5;247m'  # gray  — dirty
  else
    section_branch_foreground_color='\033[38;5;2m'    # green — clean
  fi
  
  branch_str=$(printf "${section_branch_foreground_color} \ue0a0 ${git_branch}\033[0m\033[48;5;${section_branch_background_color}m")
fi

# --- Context window ---
# O Claude Code reporta context_window_size=200000 e used_percentage contra 200k
# mesmo em modelos de janela maior (Opus = 1M). Recalcular contra a janela real do
# modelo, usando total_input_tokens (ocupação de contexto) como numerador.
model_id=$(echo "${json_input}" | jq --raw-output '.model.id // ""')
reported_window=$(echo "${json_input}" | jq --raw-output '.context_window.context_window_size // 200000')
context_input_tokens=$(echo "${json_input}" | jq --raw-output '.context_window.total_input_tokens // 0')

case "${model_id}" in
  *opus*) context_window_real=1000000 ;;   # Opus: janela de 1M
  *)      context_window_real="${reported_window}" ;;
esac
[ "${context_window_real}" -lt "${reported_window}" ] 2>/dev/null && context_window_real="${reported_window}"

if [ "${context_window_real}" -gt 0 ] 2>/dev/null; then
  used_int=$(( context_input_tokens * 100 / context_window_real ))
else
  used_pct=$(echo "${json_input}" | jq --raw-output '.context_window.used_percentage // 0')
  used_int=$(printf '%.0f' "$used_pct")
fi
[ "${used_int}" -gt 100 ] 2>/dev/null && used_int=100
transcript_path=$(echo "${json_input}" | jq --raw-output '.transcript_path // ""')
if [ -n "${transcript_path}" ] && [ -f "${transcript_path}" ]; then
  turn_count=$(jq --slurp '[.[] | select(.type == "user") | .message.content | if type == "array" then .[0].type else "text" end | select(. != "tool_result")] | length' "${transcript_path}" 2>/dev/null || echo 0)
else
  turn_count=0
fi

if   [ "$used_int" -ge "${context_threshold_critical}" ]; then
  section_context_background_color=1
  section_context_foreground_color=0
elif [ "$used_int" -ge "${context_threshold_warning}" ]; then
  section_context_background_color=3
  section_context_foreground_color=0
else
  section_context_background_color=2
  section_context_foreground_color=0
fi

# --- Session time ---
session_duration=$(process-uptime --name claude --format human-short)
elapsed_seconds=$(process-uptime --name claude --format seconds)

if   [ "${elapsed_seconds}" -ge "${session_duration_seconds_threshold_critical}" ]; then
  section_time_background_color=88
  section_time_foreground_color=15  # white on bordeaux
elif [ "${elapsed_seconds}" -ge "${session_duration_seconds_threshold_warning}"  ]; then
  section_time_background_color=215
  section_time_foreground_color=0   # black on orange
elif [ "${elapsed_seconds}" -ge "${session_duration_seconds_threshold_caution}"  ]; then
  section_time_background_color=221
  section_time_foreground_color=0   # black on amber
else
  section_time_background_color=114
  section_time_foreground_color=0   # black on green
fi

# --- Model ---
model=$(echo "${json_input}" | jq --raw-output '.model.display_name // "N/A"')

# --- Total tokens ---
total_input=$(echo "${json_input}" | jq --raw-output '.context_window.total_input_tokens // 0')
total_output=$(echo "${json_input}" | jq --raw-output '.context_window.total_output_tokens // 0')
total_tokens=$(( total_input + total_output ))

if [ "${total_tokens}" -ge 1000 ]; then
  tokens_display="$(( total_tokens / 1000 ))k"
else
  tokens_display="${total_tokens}"
fi

# --- Account usage limits (5-hour session window, 7-day window) ---
# Absent for API-key accounts; the segment is omitted then.

# Prints the time left up to an epoch, such as 5d12h, 2h18m or 45m, or the fallback once it has passed
time_left() {
  local left=$(( ${1} - $(date +%s) ))

  if   [ "${left}" -le 0 ];     then echo "${2}"
  elif [ "${left}" -ge 86400 ]; then echo "$(( left / 86400 ))d$(( left % 86400 / 3600 ))h"
  elif [ "${left}" -ge 3600 ];  then echo "$(( left / 3600 ))h$(( left % 3600 / 60 ))m"
  else                               echo "$(( left / 60 ))m"
  fi
}

limit_str() {
  local label="${1}" window="${2}" reset_format="${3}"
  local used used_exact resets_at color reset_display=""

  used_exact=$(echo "${json_input}" | jq --raw-output ".rate_limits.${window}.used_percentage // empty")
  [ -z "${used_exact}" ] && return
  # Round up, to be cautious
  used=$(awk --assign value="${used_exact}" 'BEGIN { print (value == int(value)) ? value : int(value) + 1 }')
  resets_at=$(echo "${json_input}" | jq --raw-output ".rate_limits.${window}.resets_at // empty")
  if [ -n "${resets_at}" ]; then
    reset_display=" ↻ $(date --date "@${resets_at}" "+${reset_format}")"
    label=$(time_left "${resets_at}" "${label}")
  fi

  if   [ "${used}" -ge "${limits_threshold_critical}" ]; then color=203  # salmon
  elif [ "${used}" -ge "${limits_threshold_warning}"  ]; then color=221  # amber
  else                                                         color=114  # green
  fi

  printf "\033[38;5;247m%s \033[38;5;${color}m%s%%\033[38;5;247m%s" "${label}" "${used}" "${reset_display}"
}

# Prints a percentage with one decimal and a comma, without the decimal when it is zero
percentage_display() {
  awk --assign value="${1}" 'BEGIN { shown = sprintf("%.1f", value); sub(/\.0$/, "", shown); sub(/\./, ",", shown); print shown }'
}

# Today's guidance from the weekly quota: the usage so far and the percentage to reach by the end of today
today_str() {
  local used_exact resets_at today_goal goal_reached

  used_exact=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.used_percentage // empty')
  resets_at=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.resets_at // empty')
  [ -z "${used_exact}" ] || [ -z "${resets_at}" ] && return

  today_goal=$(claude-usage-plan --used "${used_exact}" --resets-at "${resets_at}" --today-goal 2>/dev/null)
  [ -z "${today_goal}" ] && return

  # The share of today's goal already reached
  goal_reached=$(percentage_display "$(awk --assign used="${used_exact}" --assign goal="${today_goal}" 'BEGIN { print (goal > 0) ? used * 100 / goal : 0 }')")

  printf "\033[38;5;247mtoday \033[38;5;255m%s%%\033[38;5;247m of \033[38;5;255m%s%%" "${goal_reached}" "${today_goal}"
}

# The week's forecast: the percentage used at the reset at this pace, and the signal it gives
forecast_str() {
  local used_exact resets_at forecast signal color

  used_exact=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.used_percentage // empty')
  resets_at=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.resets_at // empty')
  [ -z "${used_exact}" ] || [ -z "${resets_at}" ] && return

  read -r forecast signal < <(claude-usage-forecast --used "${used_exact}" --resets-at "${resets_at}" --with-percentage 2>/dev/null)
  [ -z "${signal}" ] && return

  case "${signal}" in
    push   ) color=114 ;;
    steady ) color=221 ;;
    slow   ) color=203 ;;
  esac

  # Only the signal carries the color: the number just stands out from the label
  printf "\033[38;5;247mforecast \033[38;5;255m%s%% \033[1;38;5;%sm%s\033[22m" "$(percentage_display "${forecast}")" "${color}" "${signal}"
}

# Save the weekly usage for claude-usage-plan, whatever segments are shown (the status line is the only place that receives it)
weekly_used=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.used_percentage // empty')
weekly_resets_at=$(echo "${json_input}" | jq --raw-output '.rate_limits.seven_day.resets_at // empty')

if [ -n "${weekly_used}" ] && [ -n "${weekly_resets_at}" ]; then
  weekly_cache_directory="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-status-line"
  mkdir --parents "${weekly_cache_directory}"
  jq --null-input \
    --argjson used "${weekly_used}" \
    --argjson resets_at "${weekly_resets_at}" \
    --argjson saved_at "$(date +%s)" \
    '{used_percentage: $used, resets_at: $resets_at, saved_at: $saved_at}' \
    > "${weekly_cache_directory}/weekly.json.$$" \
  && mv "${weekly_cache_directory}/weekly.json.$$" "${weekly_cache_directory}/weekly.json"

  # The first reading of each day is that day's starting point; noclobber keeps it when several sessions race
  weekly_history_directory="${weekly_cache_directory}/weekly-history"
  weekly_today=$(date +%F)
  if [ ! -f "${weekly_history_directory}/${weekly_today}.json" ]; then
    mkdir --parents "${weekly_history_directory}"
    (
      set -o noclobber
      jq --null-input --compact-output \
        --arg date "${weekly_today}" \
        --argjson used "${weekly_used}" \
        --argjson resets_at "${weekly_resets_at}" \
        --argjson saved_at "$(date +%s)" \
        '{date: $date, used_percentage: $used, resets_at: $resets_at, saved_at: $saved_at, source: "status-line"}' \
        > "${weekly_history_directory}/${weekly_today}.json"
    ) 2>/dev/null
  fi
fi

# Which segments to show: both, session, weekly or none (set with claude-status-line-limits)
limits_choice=$(claude-status-line-limits)

limits_five_hour=""
limits_seven_day=""
limits_today=""
limits_forecast=""
[[ "${limits_choice}" == both || "${limits_choice}" == session ]] && limits_five_hour=$(limit_str "5h" five_hour "%H:%M")
[[ "${limits_choice}" == both || "${limits_choice}" == weekly  ]] && limits_seven_day=$(limit_str "7d" seven_day "%a %H:%M")
[[ "${limits_choice}" == both || "${limits_choice}" == weekly  ]] && limits_today=$(today_str)
[[ "${limits_choice}" == both || "${limits_choice}" == weekly  ]] && limits_forecast=$(forecast_str)

# Assemble segments with powerline separators
segment_separator=$'\ue0b0'
_last_segment_background=""

add_segment() {
  local background_color="" args=()

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --background ) background_color="${2}"; args+=("${1}" "${2}"); shift 2 ;;
      *            ) args+=("${1}");                                 shift   ;;
    esac
  done

  if [ -n "${_last_segment_background}" ] && [ "${_last_segment_background}" != "${background_color}" ]; then
    ansi-text \
      --text "${segment_separator}" \
      --background "${background_color}" \
      --foreground "${_last_segment_background}"
  fi

  ansi-text "${args[@]}"
  _last_segment_background="${background_color}"
}

end_segments() {
  printf "\033[0m\033[38;5;${_last_segment_background}m%s\033[0m" "${segment_separator}"
}

# Pontos (~/.claude/rules/pontos.md) raises this file when a raw log is blocked by its check or its upload failed
[ -f "${HOME}/.local/state/pontos/alert" ] && \
add_segment --text " ⚠ pontos " --background "${section_pontos_background_color}" --foreground 15 --bold

# disk-watch (scripts/utilities/disk-watch/README.md) writes this file while the disk is above its warning threshold
disk_alert_file="${XDG_STATE_HOME:-${HOME}/.local/state}/disk-watch/alert"
if [ -f "${disk_alert_file}" ]; then
  read -r disk_level disk_percent < <(jq --raw-output '"\(.level) \(.percent)"' "${disk_alert_file}" 2>/dev/null)
  if [ -n "${disk_percent}" ]; then
    if [ "${disk_level}" == "critical" ]; then
      add_segment --text " ⚠ disk ${disk_percent}% " --background "${section_disk_critical_background_color}" --foreground 15 --bold
    else
      add_segment --text " ⚠ disk ${disk_percent}% " --background "${section_disk_warning_background_color}" --foreground 0 --bold
    fi
  fi
fi

add_segment --text " ${location} " --background "${section_location_background_color}" --foreground 0 --bold

if [ -n "${git_branch}" ]; then
  add_segment --text "${branch_str} "     --background "${section_branch_background_color}"

  [ -n "${git_indicators}" ] && \
  add_segment --text "${git_indicators} " --background "${section_branch_background_color}"
fi

add_segment --text " ≡ ${used_int}% "        --background "${section_context_background_color}" --foreground "${section_context_foreground_color}"
[ -n "${limits_five_hour}" ] && \
add_segment --text " ${limits_five_hour} "   --background "${section_limits_five_hour_background_color}"
[ -n "${limits_seven_day}" ] && \
add_segment --text " ${limits_seven_day} "   --background "${section_limits_seven_day_background_color}"
[ -n "${limits_today}" ] && \
add_segment --text " ${limits_today} "       --background "${section_limits_today_background_color}"
[ -n "${limits_forecast}" ] && \
add_segment --text " ${limits_forecast} "    --background "${section_limits_forecast_background_color}"
add_segment --text " ◔ ${session_duration} " --background "${section_time_background_color}"    --foreground "${section_time_foreground_color}"
add_segment --text " ⇌ ${turn_count} "       --background "${section_turns_background_color}"   --foreground 247
add_segment --text " ✦ ${model} "            --background "${section_model_background_color}"   --foreground 247
add_segment --text " ◈ ${tokens_display} "   --background "${section_tokens_background_color}"  --foreground 0

end_segments
