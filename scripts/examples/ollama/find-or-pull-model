#!/usr/bin/env bash
set -euo pipefail

lm_studio_models_dir="${HOME}/.cache/lm-studio/models"
model_name_to_pull="${OLLAMA_MODEL_NAME:-qwen2.5:7b}"

echo "Buscando modelo Qwen em ${lm_studio_models_dir}..."

if [[ -d "${lm_studio_models_dir}" ]]; then
  gguf_path="$(
    find "${lm_studio_models_dir}" -iname "*.gguf" \
    | grep --ignore-case "${model_name_to_pull}" \
    | head --lines=1 || true
  )"

  if [[ -n "${gguf_path}" ]]; then
    echo "Modelo encontrado: ${gguf_path}"
    export OLLAMA_MODEL_PATH="${gguf_path}"
    export OLLAMA_MODEL_SOURCE="local"
    return 0 2>/dev/null || exit 0
  fi
fi

echo "Nenhum GGUF do LM Studio encontrado. Fazendo pull: ${model_name_to_pull}"
ollama pull "${model_name_to_pull}"
export OLLAMA_MODEL_NAME="${model_name_to_pull}"
export OLLAMA_MODEL_SOURCE="registry"
