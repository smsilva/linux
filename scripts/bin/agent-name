#!/bin/bash
this_script_path="$(realpath "${0}")"
this_script_name="${this_script_path##*/}"

# Every agent session on this machine gets a unique name from the active lists of names (claude/agent-names/lists).
# One file per name in the state folder, written under one flock, holds the session id, the pid and the time it was
# taken. Names go round like hurricane names: .queue holds the names still to come in this round, the next session
# takes the first free one, and a new round is built only when the queue ends, so no name comes back before the whole
# round has passed. The configuration (lists, scope, order) decides how a round is built. A closed session's name, or
# one whose pid is gone, comes back on its turn.

config_directory="${this_script_path%/*}/../../claude/agent-names"
lists_directory="${config_directory}/lists"

# The session id a launcher reserves a name with, before Claude Code has one (agent: launcher-<pid>).
LAUNCHER_PREFIX="launcher-"

state_directory="${AGENT_NAME_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/agent-names}"
local_config="${AGENT_NAME_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/agent-names/config}"

lists=""
scope=""
order=""

show_usage() {
  cat <<EOF

  Gives each agent session on this machine a unique name from the active
  lists of names; with all of them in use, the names take a suffix (ploto-2).

    Commands:

      acquire --session-id <id> --pid <pid> [--name <name>]
                  Takes a name and prints it: the one this session or pid
                  (or one of its parent processes) already holds, else
                  --name when free, else the next free one of the queue,
                  built anew when it ends. A name whose pid is no longer
                  alive counts as free.
      release --session-id <id>
                  Frees the name that session holds.
      whoami  --session-id <id>
                  Prints the name that session holds.
      list        Shows the names in use: name, session id, pid, time.
      config      Shows the configuration in force.
      hook        Claude Code hook (SessionStart, SessionEnd): reads the
                  hook's JSON on stdin.

    Configuration:

      claude/agent-names/config, then ~/.config/agent-names/config on top:

      lists=nereids,nato  Active lists, in order (claude/agent-names/lists)
      scope=list          list: finish one list, then the next; all: one pool
      order=random        listed, alphabetical or random

    Environment:

      AGENT_NAME_STATE_DIR  State folder (default: ~/.local/state/agent-names)
      AGENT_NAME_CONFIG     Local configuration (default: ~/.config/agent-names/config)
      AGENT_NAME_SEED       Makes the random order reproducible (tests)
      AGENT_NAME            Preferred name, passed by the launcher (agent)

    Examples:

      ${this_script_name} acquire --session-id 0f3c9a1e --pid 4242

      ${this_script_name} whoami --session-id 0f3c9a1e

      ${this_script_name} release --session-id 0f3c9a1e

      ${this_script_name} list

EOF
}

field() {
  local file="${1?}"
  local key="${2?}"
  sed --quiet "s/^${key}=//p" "${file}" 2>/dev/null | head --lines 1
}

start_time() {
  # Field 22 of /proc/<pid>/stat: when the process started, so a reused pid is not taken for the old holder.
  local pid="${1?}"
  [[ -r "/proc/${pid}/stat" ]] || return 0
  sed 's/^.*) //' "/proc/${pid}/stat" | cut --delimiter ' ' --fields 20
}

alive() {
  local file="${1?}"
  local pid
  local started
  pid="$(field "${file}" pid)"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  [[ -d "/proc/${pid}" ]] || kill -0 "${pid}" 2>/dev/null || return 1
  started="$(field "${file}" started)"
  [[ -z "${started}" || "${started}" == "$(start_time "${pid}")" ]]
}

ancestors() {
  # The pid itself, then each parent up to init.
  local pid="${1?}"
  while [[ "${pid}" =~ ^[0-9]+$ && "${pid}" -gt 1 ]]; do
    echo "${pid}"
    pid="$(ps -o ppid= -p "${pid}" 2>/dev/null | tr --delete ' ')"
  done
}

name_files() {
  local file
  for file in "${state_directory}"/*; do
    [[ -f "${file}" && "${file##*/}" != .* ]] && echo "${file}"
  done
}

write() {
  local name="${1?}"
  local session_id="${2?}"
  local pid="${3?}"
  local file="${state_directory}/${name}"
  printf 'session_id=%s\npid=%s\nstarted=%s\nacquired_at=%s\n' \
    "${session_id}" \
    "${pid}" \
    "$(start_time "${pid}")" \
    "$(date --iso-8601=seconds)" > "${file}.tmp"
  mv "${file}.tmp" "${file}"
  echo "${name}"
}

free() {
  local name="${1?}"
  [[ ! -f "${state_directory}/${name}" ]] || ! alive "${state_directory}/${name}"
}

read_config_file() {
  local file="${1?}"
  local line
  local key
  local value
  [[ -f "${file}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%%#*}"
    line="${line//[[:space:]]/}"
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    case "${key}" in
      lists ) lists="${value}" ;;
      scope ) scope="${value}" ;;
      order ) order="${value}" ;;
      * ) echo "${this_script_name}: unknown key in ${file}: ${key}" >&2; return 1 ;;
    esac
  done < "${file}"
}

load_config() {
  local list
  read_config_file "${config_directory}/config" || return 1
  read_config_file "${local_config}" || return 1
  [[ "${scope}" == "list" || "${scope}" == "all" ]] || { echo "${this_script_name}: scope must be list or all: ${scope}" >&2; return 1; }
  [[ "${order}" == "listed" || "${order}" == "alphabetical" || "${order}" == "random" ]] || { echo "${this_script_name}: order must be listed, alphabetical or random: ${order}" >&2; return 1; }
  [[ -n "${lists}" ]] || { echo "${this_script_name}: no active list" >&2; return 1; }
  for list in ${lists//,/ }; do
    [[ -f "${lists_directory}/${list}" ]] || { echo "${this_script_name}: no list named ${list}" >&2; return 1; }
  done
}

names_of() {
  local list="${1?}"
  sed '/^#/d;/^$/d' "${lists_directory}/${list}"
}

all_names() {
  # Every active name once, in the order of the lists.
  local list
  for list in ${lists//,/ }; do
    names_of "${list}"
  done | awk '!seen[$0]++'
}

arrange() {
  case "${order}" in
    listed ) cat ;;
    alphabetical ) sort ;;
    random )
      if [[ -n "${AGENT_NAME_SEED:-}" ]]; then
        shuf --random-source <(yes "${AGENT_NAME_SEED}")
      else
        shuf
      fi
      ;;
  esac
}

build_round() {
  local list
  if [[ "${scope}" == "list" ]]; then
    for list in ${lists//,/ }; do
      names_of "${list}" | arrange
    done | awk '!seen[$0]++'
  else
    all_names | arrange
  fi
}

fingerprint() {
  # Changes when the configuration or an active list changes, which ends the round.
  local list
  {
    echo "${lists} ${scope} ${order}"
    for list in ${lists//,/ }; do
      names_of "${list}"
    done
  } | sha256sum | cut --delimiter ' ' --fields 1
}

save_queue() {
  printf '%s\n' "${@}" > "${state_directory}/.queue.tmp"
  mv "${state_directory}/.queue.tmp" "${state_directory}/.queue"
}

take_from() {
  # Prints the first free name of the arguments and saves the ones after it as the queue.
  local index=0
  local names=("${@}")
  for index in "${!names[@]}"; do
    if free "${names[${index}]}"; then
      save_queue "${names[@]:$(( index + 1 ))}"
      echo "${names[${index}]}"
      return 0
    fi
  done
  return 1
}

next_name() {
  # The first free name of this round, else of a new round. All in use: fails, and the new round waits at its top.
  local current
  local queue=()
  current="$(fingerprint)"
  if [[ -f "${state_directory}/.queue" && "$(cat "${state_directory}/.queue-config" 2>/dev/null)" == "${current}" ]]; then
    mapfile -t queue < <(sed '/^$/d' "${state_directory}/.queue")
    [[ "${#queue[@]}" -gt 0 ]] && take_from "${queue[@]}" && return 0
  fi
  mapfile -t queue < <(build_round)
  echo "${current}" > "${state_directory}/.queue-config"
  take_from "${queue[@]}" && return 0
  save_queue "${queue[@]}"
  return 1
}

valid_name() {
  [[ "${1}" =~ ^[a-z]+(-[a-z]+)?(-[0-9]+)?$ ]]
}

acquire() {
  local session_id="${1?}"
  local pid="${2?}"
  local preferred="${3:-}"
  local file
  local holder
  local round
  local name

  # The session already holds one (a resume, a second SessionStart).
  for file in $(name_files); do
    if [[ "$(field "${file}" session_id)" == "${session_id}" ]]; then
      write "${file##*/}" "${session_id}" "${pid}"
      return
    fi
  done

  # This process holds one (after /clear), or the launcher that started it reserved one (agent --name). Only a
  # launcher's reservation passes down: a `claude -p` run inside a session gets its own name, so its SessionEnd
  # never frees its parent's.
  for holder in $(ancestors "${pid}"); do
    for file in $(name_files); do
      if [[ "$(field "${file}" pid)" == "${holder}" ]] \
        && { [[ "${holder}" == "${pid}" ]] || [[ "$(field "${file}" session_id)" == "${LAUNCHER_PREFIX}"* ]]; } \
        && alive "${file}"; then
        write "${file##*/}" "${session_id}" "${pid}"
        return
      fi
    done
  done

  if [[ -n "${preferred}" ]] && valid_name "${preferred}" && free "${preferred}"; then
    write "${preferred}" "${session_id}" "${pid}"
    return
  fi

  load_config || return 1
  if name="$(next_name)"; then
    write "${name}" "${session_id}" "${pid}"
    return
  fi

  # Every active name is in use: a suffix, in the order of the lists.
  round=2
  while true; do
    for name in $(all_names); do
      name="${name}-${round}"
      if free "${name}"; then
        write "${name}" "${session_id}" "${pid}"
        return
      fi
    done
    round=$(( round + 1 ))
  done
}

release() {
  local session_id="${1?}"
  local file
  for file in $(name_files); do
    if [[ "$(field "${file}" session_id)" == "${session_id}" ]]; then
      rm --force "${file}"
    fi
  done
}

whoami_of() {
  local session_id="${1?}"
  local file
  for file in $(name_files); do
    if [[ "$(field "${file}" session_id)" == "${session_id}" ]]; then
      echo "${file##*/}"
      return 0
    fi
  done
  return 1
}

list() {
  local file
  local state
  printf '%-12s %-38s %-8s %-6s %s\n' NAME SESSION PID STATE ACQUIRED
  for file in $(name_files); do
    state="alive"
    alive "${file}" || state="stale"
    printf '%-12s %-38s %-8s %-6s %s\n' \
      "${file##*/}" \
      "$(field "${file}" session_id)" \
      "$(field "${file}" pid)" \
      "${state}" \
      "$(field "${file}" acquired_at)"
  done
}

claude_pid() {
  # The Claude Code process that runs this hook: the first ancestor named claude, else the parent.
  local pid
  for pid in $(ancestors "${PPID}"); do
    if [[ "$(ps -o comm= -p "${pid}" 2>/dev/null)" == "claude" ]]; then
      echo "${pid}"
      return
    fi
  done
  echo "${PPID}"
}

hook() {
  local input
  local event
  local session_id
  local name
  input="$(cat)"
  event="$(jq --raw-output '.hook_event_name // empty' <<< "${input}")"
  session_id="$(jq --raw-output '.session_id // empty' <<< "${input}")"
  [[ -n "${session_id}" ]] || exit 0
  case "${event}" in
    SessionStart )
      name="$(locked acquire "${session_id}" "${AGENT_NAME_PID:-$(claude_pid)}" "${AGENT_NAME:-}")" || exit 0
      jq --null-input --arg name "${name}" '{
        hookSpecificOutput: {
          hookEventName: "SessionStart",
          additionalContext: ("Your name is " + $name + " (agent-name, unique among the agent sessions on this machine). Say it when the owner asks your name, and sign cross-session messages, orders and replies with it when relevant.")
        }
      }'
      ;;

    SessionEnd )
      # After /clear the same process goes on with a new session id: keep its name for the next SessionStart.
      [[ "$(jq --raw-output '.reason // empty' <<< "${input}")" == "clear" ]] && exit 0
      locked release "${session_id}"
      ;;
  esac
}

migrate_state_directory() {
  # Once, from the folder of the time this script was nato-name; the names in use stay valid.
  local old="${XDG_STATE_HOME:-${HOME}/.local/state}/nato-names"
  [[ -z "${AGENT_NAME_STATE_DIR:-}" && -d "${old}" && ! -e "${state_directory}" ]] || return 0
  mv "${old}" "${state_directory}" 2>/dev/null
  rm --force "${state_directory}/.last"
}

show_config() {
  load_config || return 1
  echo "lists=${lists}"
  echo "scope=${scope}"
  echo "order=${order}"
  echo "names=$(all_names | wc --lines)"
}

locked() {
  mkdir --parents "${state_directory}"
  (
    flock --exclusive --timeout 5 9 || {
      echo "${this_script_name}: cannot lock ${state_directory}" >&2
      exit 1
    }
    "${@}"
  ) 9> "${state_directory}/.lock"
}

command="${1:-}"
[[ -n "${command}" ]] && shift

session_id=""
pid=""
preferred=""

while [[ "${1}" =~ ^- ]]; do
  case "${1}" in
    --session-id )
      shift
      session_id="${1?}"
      ;;

    --pid )
      shift
      pid="${1?}"
      ;;

    --name )
      shift
      preferred="${1?}"
      ;;

    -h | --help )
      show_usage
      exit 0
      ;;

    * )
      echo "Unknown option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

migrate_state_directory

case "${command}" in
  acquire )
    [[ -n "${session_id}" && "${pid}" =~ ^[0-9]+$ ]] || { echo "acquire needs --session-id <id> and --pid <pid>" >&2; exit 1; }
    locked acquire "${session_id}" "${pid}" "${preferred}"
    ;;

  release )
    [[ -n "${session_id}" ]] || { echo "release needs --session-id <id>" >&2; exit 1; }
    locked release "${session_id}"
    ;;

  whoami )
    [[ -n "${session_id}" ]] || { echo "whoami needs --session-id <id>" >&2; exit 1; }
    whoami_of "${session_id}"
    ;;

  list )
    list
    ;;

  config )
    show_config
    ;;

  hook )
    hook
    ;;

  -h | --help | help )
    show_usage
    ;;

  * )
    show_usage
    exit 1
    ;;
esac
